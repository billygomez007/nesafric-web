model SecurityDeposit {
  id                     String                       @id @default(uuid()) @db.Uuid
  organisationId         String                       @db.Uuid
  tenantOrganisationId   String                       @db.Uuid
  leaseId                String                       @db.Uuid
  propertyId             String                       @db.Uuid
  unitId                 String?                      @db.Uuid
  paymentIntentId        String?                      @unique @db.Uuid
  internalReference      String
  amountMinor            Decimal                      @db.Decimal(19, 0)
  currencyCode           String                       @db.Char(3)
  receivedAt             DateTime
  method                 PaymentMethod
  /// MANUAL deposits are staff-recorded (e.g. cash/bank evidence); PROVIDER deposits are created
  /// only by `reconcileProviderEvent` after a verified successful provider webhook, and are never
  /// created from an unverified checkout redirect.
  source                 SecurityDepositSource        @default(MANUAL)
  externalReference      String
  providerKey            String?
  providerTransactionRef String?
  idempotencyKey         String
  evidenceReference      String?
  status                 SecurityDepositStatus        @default(HELD)
  refundedAmountMinor    Decimal                      @default(0) @db.Decimal(19, 0)
  deductedAmountMinor    Decimal                      @default(0) @db.Decimal(19, 0)
  notes                  String?
  recordedByUserId       String                       @db.Uuid
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  organisation           Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenantOrganisation     TenantOrganisation           @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)
  lease                  Lease                        @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  property               Property                     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit                   Unit?                        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  paymentIntent          PaymentIntent?               @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  ledgerEntries          FinancialLedgerEntry[]
  reconciliationEvents   PaymentReconciliationEvent[]

  @@unique([organisationId, internalReference])
  @@unique([organisationId, idempotencyKey])
  @@unique([providerKey, providerTransactionRef])
  @@index([organisationId, leaseId, receivedAt])
}

