model PaymentIntent {
  id                   String               @id @default(uuid()) @db.Uuid
  organisationId       String               @db.Uuid
  tenantOrganisationId String               @db.Uuid
  leaseId              String               @db.Uuid
  propertyId           String               @db.Uuid
  unitId               String?              @db.Uuid
  internalReference    String
  amountMinor          Decimal              @db.Decimal(19, 0)
  currencyCode         String               @db.Char(3)
  method               PaymentMethod
  /// Which ledger this checkout ultimately feeds: RENT flows into rent allocation/receipts as
  /// before; DEPOSIT keeps the money financially separate and, once the provider webhook
  /// verifies success, produces a `SecurityDeposit` instead of a `Payment`. Set once at intent
  /// creation by the calling service function (never a user-supplied field), so a checkout can
  /// never be relabelled after the fact.
  purpose              PaymentIntentPurpose @default(RENT)
  status               PaymentStatus        @default(PENDING)
  providerKey          String
  providerIntentRef    String?
  idempotencyKey       String
  providerPayload      Json?
  expiresAt            DateTime?
  createdByUserId      String               @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organisation         Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  tenantOrganisation   TenantOrganisation   @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)
  lease                Lease                @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit                 Unit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  payments             Payment[]
  securityDeposit      SecurityDeposit?

  @@unique([organisationId, internalReference])
  @@unique([organisationId, idempotencyKey])
  @@unique([providerKey, providerIntentRef])
  @@index([organisationId, status, createdAt])
}

