  defaultCurrencyCode         String                            @db.Char(3)
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  archivedAt                  DateTime?
  country                     Country                           @relation(fields: [countryCode], references: [code])
  members                     OrganisationMember[]
  invitations                 OrganisationInvitation[]
  portfolios                  Portfolio[]
  properties                  Property[]                        @relation("ManagingOrganisation")
  auditEvents                 AuditEvent[]
  domainEvents                DomainEvent[]
  tenants                     TenantOrganisation[]
  leases                      Lease[]
  reminderPolicies            ReminderPolicy[]
  notifications               Notification[]
  backgroundJobs              BackgroundJob[]
  notifyEmail                 Boolean                           @default(true)
  notifySms                   Boolean                           @default(false)
  notifyWhatsapp              Boolean                           @default(false)
  rentObligations             RentObligation[]
  paymentIntents              PaymentIntent[]
  payments                    Payment[]
  receipts                    Receipt[]
  securityDeposits            SecurityDeposit[]
  ledgerEntries               FinancialLedgerEntry[]
  reconciliationEvents        PaymentReconciliationEvent[]
  maintenanceRequests         MaintenanceRequest[]
  workOrders                  WorkOrder[]
  maintenanceApprovals        MaintenanceApproval[]
  providerProfile             ServiceProvider?                  @relation("CompanyProviderOrganisation")
  providerDirectories         ProviderOrganisation[]            @relation("LandlordProviderDirectory")
  quotationRequests           ProviderQuotationRequest[]        @relation("LandlordQuotationRequests")
  providerQuotations          ProviderQuotation[]               @relation("LandlordProviderQuotations")
  providerAssignments         ProviderAssignment[]              @relation("LandlordProviderAssignments")
  providerRatings             ProviderRating[]                  @relation("LandlordProviderRatings")
  marketplaceEnquiries        MarketplaceEnquiry[]              @relation("MarketplaceRequestingOrganisation")
  listings                    Listing[]
  moveOuts                    MoveOut[]
  vacancyTurnovers            VacancyTurnover[]
  depositSettlements          DepositSettlement[]
  depositDeductions           DepositDeduction[]
  depositRefunds              DepositRefund[]
  aiSessions                  AISession[]
  aiToolExecutions            AIToolExecution[]
  aiActionProposals           AIActionProposal[]
  aiAutonomyConfig            AIAutonomyConfiguration?
  aiAutonomyPolicies          AIAutonomyPolicy[]
  aiActivities                AIActivity[]
  aiEmployees                 AIEmployee[]
  aiEmployeeHandoffs          AIEmployeeHandoff[]
  aiEmployeeActivities        AIEmployeeActivity[]
  marketplaceLeads            MarketplaceLead[]
  viewingRequests             ViewingRequest[]
  moveIns                     MoveIn[]
  noticesToVacate             NoticeToVacate[]
  applicants                  Applicant[]
  rentalApplications          RentalApplication[]
  conversations               Conversation[]
  communicationChannels       CommunicationChannelConfig[]
  conversationParticipants    ConversationParticipant[]
  messages                    Message[]
  messageDeliveries           MessageDelivery[]
  conversationAssignments     ConversationAssignment[]
  storageObjects              StorageObject[]
  generatedDocuments          GeneratedDocument[]
  documentTemplates           DocumentTemplate[]
  signatureProviderEvents     SignatureProviderEvent[]
  geocodeLookups              GeocodeLookup[]
  calendarEvents              CalendarEvent[]
  integrationConfigs          IntegrationConfig[]
  subscription                OrganisationSubscription?
  subscriptionInvoices        SubscriptionInvoice[]
  subscriptionStatusHistory   SubscriptionStatusHistory[]
  entitlementOverrides        OrganisationEntitlementOverride[]
  billingWebhookEvents        BillingWebhookEvent[]
  platformSupportSessions     PlatformSupportSession[]
  platformAuditEvents         PlatformAuditEvent[]
  featureFlagOverrides        OrganisationFeatureFlagOverride[]
  maintenanceDispatchAttempts MaintenanceDispatchAttempt[]
  /// Present only when this Organisation exists purely as the technical backing store for a
  /// Marketplace professional profile (Phase 21A item 7) — created by
  /// `marketplace-professionals/service.ts`, never through the ordinary `createOrganisation`
  /// onboarding path, and never given an `OrganisationSubscription` (item 8: marketplace
  /// professionals are never attached to a PropertyOS management subscription). Every
  /// PropertyOS-facing organisation listing (`listUserOrganisations`, the dashboard organisation
  /// switcher) excludes organisations where this relation is non-null, so a marketplace account
  /// never sees PropertyOS management screens merely because it has a marketplace profile.
  marketplaceProfessional     MarketplaceProfessional?
  voiceProviderConfig         VoiceProviderConfig?
  voiceCalls                  VoiceCall[]
  voiceContactPreferences     VoiceContactPreference[]
  phoneNumbers                PhoneNumber[]
  mediaStreamSessions         MediaStreamSession[]

  @@index([countryCode])
  @@index([archivedAt])
}

model OrganisationMember {
  id                      String                   @id @default(uuid()) @db.Uuid
  organisationId          String                   @db.Uuid
  userId                  String                   @db.Uuid
  status                  MemberStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  archivedAt              DateTime?
  organisation            Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles                   MembershipRole[]
