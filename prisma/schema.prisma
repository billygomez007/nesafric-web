// Phase 17 - Omnichannel Communications + AI Receptionist Integration.
// VOICE is intentionally not modelled yet; the channel/adapter architecture is designed so a
// future VOICE channel can be added without redesigning conversations, messages, or delivery.
enum ConversationChannel {
  WEB_CHAT
  EMAIL
  WHATSAPP
  SMS
  IN_APP
  /// Phase 22 — a telephone call. `VoiceCall` carries the telephony-specific detail (direction,
  /// provider call id, duration, recording, transcript); the `Conversation` row it belongs to
  /// carries the same business context (related listing/tenant/lead/work order, assigned AI
  /// employee, status, summary) every other channel already uses — no parallel domain model.
  VOICE
}

