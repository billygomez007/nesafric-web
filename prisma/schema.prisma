  failureReason          String?
  createdByUserId        String?                      @db.Uuid
  confirmedAt            DateTime?
  reversedAt             DateTime?
  reversedByUserId       String?                      @db.Uuid
  reversalReason         String?
  createdAt              DateTime                     @default(now())
