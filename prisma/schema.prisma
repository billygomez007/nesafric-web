  depositDeduction    DepositDeduction?  @relation(fields: [depositDeductionId], references: [id], onDelete: Restrict)
  depositRefund       DepositRefund?     @relation(fields: [depositRefundId], references: [id], onDelete: Restrict)

  @@unique([rentObligationId, type])
  @@index([organisationId, propertyId, effectiveAt])
  @@index([paymentId])
  @@index([securityDepositId])
  @@index([depositSettlementId])
  @@index([depositDeductionId])
  @@index([depositRefundId])
