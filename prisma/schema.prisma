  workOrderHistory                   WorkOrderHistory[]                         @relation("WorkOrderHistoryActor")
  individualProvider                 ServiceProvider?                           @relation("IndividualProviderUser")
  administeredProviders              ServiceProvider[]                          @relation("ProviderAdministrator")
  providerEvidence                   ProviderEvidence[]                         @relation("ProviderEvidenceSubmitter")
  providerVerificationHistory        ProviderVerificationHistory[]              @relation("ProviderVerificationActor")
  providerDirectoriesCreated         ProviderOrganisation[]                     @relation("ProviderDirectoryCreator")
  quotationRequestsCreated           ProviderQuotationRequest[]                 @relation("QuotationRequester")
  quotationsSubmitted                ProviderQuotation[]                        @relation("QuotationSubmitter")
  quotationsRecorded                 ProviderQuotation[]                        @relation("QuotationRecorder")
  quotationReviews                   ProviderQuotationReview[]                  @relation("QuotationReviewer")
  providerAssignmentsCreated         ProviderAssignment[]                       @relation("ProviderAssignmentCreator")
  providerAssignmentResponses        ProviderAssignment[]                       @relation("ProviderAssignmentResponder")
  providerRatings                    ProviderRating[]                           @relation("ProviderRatingCreator")
  marketplaceProfileChanges          ProviderMarketplaceProfileHistory[]        @relation("MarketplaceProfileHistoryActor")
  marketplaceEnquiriesCreated        MarketplaceEnquiry[]                       @relation("MarketplaceEnquiryRequester")
