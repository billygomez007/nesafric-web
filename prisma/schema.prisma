model ListingMedia {
  id              String                @id @default(uuid()) @db.Uuid
  listingId       String                @db.Uuid
  type            ListingMediaType
  publicUrl       String
  storageKey      String?
  /// Legacy directly-pasted media (storageKey null) and the pre-existing bulk media-array write
  /// path both default to PUBLIC, preserving their original always-public behaviour exactly. Only
  /// the new controlled per-file upload endpoint can set PRIVATE, and defaults to it — "private
  /// by default; explicit public marketplace media" (item 1) governs *that* new surface.
  classification  StorageClassification @default(PUBLIC)
  mimeType        String?
  title           String?
  altText         String?
  sortOrder       Int                   @default(0)
  isCover         Boolean               @default(false)
  width           Int?
  height          Int?
  durationSeconds Int?
  fileSizeBytes   Decimal?              @db.Decimal(19, 0)
  checksum        String?
  metadata        Json?
  createdAt       DateTime              @default(now())
  listing         Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder, createdAt])
  @@index([type, listingId])
}

