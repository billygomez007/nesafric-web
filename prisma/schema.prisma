  audits                             AuditEvent[]                               @relation("AuditActor")
  tenantRelationships                TenantOrganisation[]
  reportedMaintenanceRequests        MaintenanceRequest[]                       @relation("MaintenanceReporter")
  maintenanceHistory                 MaintenanceHistory[]                       @relation("MaintenanceHistoryActor")
  requestedMaintenanceApprovals      MaintenanceApproval[]                      @relation("MaintenanceApprovalRequester")
