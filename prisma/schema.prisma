  listingAttributionActions          ListingAttributionHistory[]                @relation("ListingAttributionActor")
  maintenanceDispatchAttemptsCreated MaintenanceDispatchAttempt[]               @relation("MaintenanceDispatchAttemptCreator")
  campaignsCreated                   Campaign[]                                 @relation("CampaignCreator")
  campaignsReviewed                  Campaign[]                                 @relation("CampaignReviewer")
  voiceCallsInitiated                VoiceCall[]                                @relation("VoiceCallInitiator")
