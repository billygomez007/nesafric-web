  marketplaceLeadActivities          MarketplaceLeadActivity[]                  @relation("MarketplaceLeadActivityActor")
  viewingRequestsCreated             ViewingRequest[]                           @relation("ViewingRequestCreator")
  viewingRequestHistory              ViewingRequestStatusHistory[]              @relation("ViewingRequestStatusActor")
  applicantsCreated                  Applicant[]                                @relation("ApplicantCreator")
  applicationsCreated                RentalApplication[]                        @relation("ApplicationCreator")
  applicationStatusHistory           RentalApplicationStatusHistory[]           @relation("ApplicationStatusActor")
  applicationActivities              RentalApplicationActivity[]                @relation("ApplicationActivityActor")
  applicationDocuments               RentalApplicationDocument[]                @relation("ApplicationDocumentUploader")
  applicationConsents                ApplicationConsent[]                       @relation("ApplicationConsentRecorder")
  leaseExecutionDocuments            LeaseExecutionDocument[]                   @relation("LeaseExecutionDocumentCreator")
  leaseSignatureActions              LeaseSignatureRequest[]                    @relation("LeaseSignatureActor")
  moveInHistory                      MoveInHistory[]                            @relation("MoveInHistoryActor")
  moveOutHistory                     MoveOutHistory[]                           @relation("MoveOutHistoryActor")
  noticesToVacateCreated             NoticeToVacate[]                           @relation("NoticeCreator")
  noticeHistory                      NoticeToVacateHistory[]                    @relation("NoticeHistoryActor")
  depositDeductionsCreated           DepositDeduction[]                         @relation("DepositDeductionCreator")
  depositDeductionsDecided           DepositDeduction[]                         @relation("DepositDeductionDecision")
  depositSettlementsApproved         DepositSettlement[]                        @relation("DepositSettlementApprover")
  depositRefundsRecorded             DepositSettlement[]                        @relation("DepositRefundRecorder")
  depositRefundTransactions          DepositRefund[]                            @relation("DepositRefundTransactionRecorder")
