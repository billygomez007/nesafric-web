model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Production-hardening pass: DB-backed login rate limiting (item 2 of the security audit — no
/// rate limiting existed anywhere in the app, including on /api/auth/login). A dedicated table
/// (not in-memory) is used because a serverless/multi-instance deployment shares no process
/// memory; Postgres is the one durable, shared store every request path already trusts.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  emailKey  String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
}

model Country {
  code                String         @id @db.Char(2)
  name                String
  defaultCurrencyCode String         @db.Char(3)
  timezone            String
  phonePrefix         String
  isActive            Boolean        @default(true)
  organisations       Organisation[]
}

model Currency {
  code      String  @id @db.Char(3)
  name      String
  minorUnit Int
  symbol    String?
  isActive  Boolean @default(true)
}

