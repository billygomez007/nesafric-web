  aiHandoffsCreated                  AIEmployeeHandoff[]                        @relation("AIHandoffCreator")
  authoredMessages                   Message[]                                  @relation("MessageAuthor")
  conversationAssignmentActions      ConversationAssignment[]                   @relation("ConversationAssignmentActor")
  storageObjectsUploaded             StorageObject[]                            @relation("StorageObjectUploader")
  storageObjectsArchived             StorageObject[]                            @relation("StorageObjectArchiver")
