model PaymentReconciliationEvent {
  id                String               @id @default(uuid()) @db.Uuid
  organisationId    String               @db.Uuid
  paymentId         String?              @db.Uuid
  /// Set instead of `paymentId` when the matched intent's purpose is DEPOSIT: a deposit checkout
  /// never creates a `Payment`, so its reconciliation trail points at the `SecurityDeposit` it
  /// produced (or stays null when the event did not result in one, e.g. FAILED/MISMATCHED).
  securityDepositId String?              @db.Uuid
  providerKey       String
  eventKey          String
  payloadHash       String
  transactionRef    String?
  status            ReconciliationStatus @default(UNMATCHED)
  receivedAt        DateTime             @default(now())
  processedAt       DateTime?
  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment           Payment?             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  securityDeposit   SecurityDeposit?     @relation(fields: [securityDepositId], references: [id], onDelete: Restrict)

  @@unique([providerKey, eventKey])
  @@index([organisationId, receivedAt])
  @@index([securityDepositId])
}

