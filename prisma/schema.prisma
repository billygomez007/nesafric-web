  id                        String                @id @default(uuid()) @db.Uuid
  marketplaceProfessionalId String                @db.Uuid
  developmentUnitId         String?               @unique @db.Uuid
  createdByUserId           String                @db.Uuid
  name                      String
  category                  String
  subtype                   String?
  purpose                   ListingType
  bedrooms                  Int?
  bathrooms                 Decimal?              @db.Decimal(4, 1)
  sizeSqm                   Decimal?              @db.Decimal(12, 2)
  currencyCode              String                @db.Char(3)
  priceMinor                Decimal               @db.Decimal(19, 0)
  countryCode               String                @db.Char(2)
  region                    String?
  city                      String?
  district                  String?
  locality                  String?
  publicLocationLabel       String?
  mapLatitude               Decimal?              @db.Decimal(10, 7)
  mapLongitude              Decimal?              @db.Decimal(10, 7)
  amenities                 String[]
  furnishing                String?
  mediaUrls                 String[]
  availabilityStatus        DevelopmentUnitStatus @default(AVAILABLE)
  availableFrom             DateTime
  authorityEvidenceReady    Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  archivedAt                DateTime?

  marketplaceProfessional MarketplaceProfessional @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Restrict)
  developmentUnit         DevelopmentUnit?        @relation(fields: [developmentUnitId], references: [id], onDelete: Restrict)
  createdBy               User                    @relation("MarketplaceAssetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  listings                Listing[]

  @@index([marketplaceProfessionalId, archivedAt, availabilityStatus])
  @@index([countryCode, city, purpose])
}

/// Append-only snapshots for every accepted listing-attribution change.
