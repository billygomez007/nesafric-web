// ---------------------------------------------------------------------------
// Phase 17 - Omnichannel Communications + AI Receptionist Integration
// ---------------------------------------------------------------------------

model Conversation {
  id                   String                    @id @default(uuid()) @db.Uuid
  organisationId       String                    @db.Uuid
  channel              ConversationChannel
  status               ConversationStatus        @default(OPEN)
  subject              String?
  channelAddress       String?
  externalThreadKey    String?
  identityLevel        ConversationIdentityLevel @default(NONE)
  propertyId           String?                   @db.Uuid
  unitId               String?                   @db.Uuid
  leaseId              String?                   @db.Uuid
  tenantOrganisationId String?                   @db.Uuid
  applicantId          String?                   @db.Uuid
  serviceProviderId    String?                   @db.Uuid
  listingId            String?                   @db.Uuid
  marketplaceLeadId    String?                   @db.Uuid
  maintenanceRequestId String?                   @db.Uuid
  workOrderId          String?                   @db.Uuid
  assignedAIEmployeeId String?                   @db.Uuid
  assignedMemberId     String?                   @db.Uuid
  aiSummary            String?
  webChatTokenHash     String?                   @unique
  lastMessageAt        DateTime?
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  organisation         Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property             Property?                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit                 Unit?                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  lease                Lease?                    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenantOrganisation   TenantOrganisation?       @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)
  applicant            Applicant?                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  serviceProvider      ServiceProvider?          @relation(fields: [serviceProviderId], references: [id], onDelete: Restrict)
  listing              Listing?                  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  marketplaceLead      MarketplaceLead?          @relation(fields: [marketplaceLeadId], references: [id], onDelete: Restrict)
  maintenanceRequest   MaintenanceRequest?       @relation(fields: [maintenanceRequestId], references: [id], onDelete: Restrict)
  workOrder            WorkOrder?                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  assignedAIEmployee   AIEmployee?               @relation(fields: [assignedAIEmployeeId], references: [id], onDelete: Restrict)
  assignedMember       OrganisationMember?       @relation("ConversationAssigneeMember", fields: [assignedMemberId], references: [id], onDelete: Restrict)
  participants         ConversationParticipant[]
  messages             Message[]
  assignments          ConversationAssignment[]
  voiceCalls           VoiceCall[]

  @@index([organisationId, status, updatedAt])
  @@index([organisationId, channel, channelAddress])
  @@index([organisationId, tenantOrganisationId])
  @@index([organisationId, marketplaceLeadId])
  @@index([organisationId, assignedAIEmployeeId, status])
  @@index([organisationId, assignedMemberId, status])
  @@index([externalThreadKey])
}

model ConversationParticipant {
  id                   String                      @id @default(uuid()) @db.Uuid
  conversationId       String                      @db.Uuid
  organisationId       String                      @db.Uuid
  type                 ConversationParticipantType
  userId               String?                     @db.Uuid
  tenantOrganisationId String?                     @db.Uuid
  applicantId          String?                     @db.Uuid
  serviceProviderId    String?                     @db.Uuid
  organisationMemberId String?                     @db.Uuid
  aiEmployeeId         String?                     @db.Uuid
  displayName          String?
  email                String?
  phone                String?
  verifiedAt           DateTime?
  createdAt            DateTime                    @default(now())
  conversation         Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organisation         Organisation                @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([organisationId, type])
}

model Message {
  id                    String              @id @default(uuid()) @db.Uuid
  conversationId        String              @db.Uuid
  organisationId        String              @db.Uuid
  channel               ConversationChannel
  direction             MessageDirection
  senderType            MessageSenderType
  senderParticipantId   String?             @db.Uuid
  aiEmployeeId          String?             @db.Uuid
  authoredByUserId      String?             @db.Uuid
  body                  String
  bodyFormat            String              @default("TEXT")
  externalMessageId     String?
  externalReferenceId   String?
  metadata              Json?
  containsSensitiveData Boolean             @default(false)
  createdAt             DateTime            @default(now())
  conversation          Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  authoredBy            User?               @relation("MessageAuthor", fields: [authoredByUserId], references: [id], onDelete: SetNull)
  deliveries            MessageDelivery[]

  @@unique([organisationId, channel, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([organisationId, createdAt])
}

model MessageDelivery {
  id                String                @id @default(uuid()) @db.Uuid
  messageId         String                @db.Uuid
  organisationId    String                @db.Uuid
  channel           ConversationChannel
  status            MessageDeliveryStatus @default(QUEUED)
  recipientAddress  String?
  providerReference String?
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  idempotencyKey    String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organisation      Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, status])
  @@index([messageId])
}

model ConversationAssignment {
  id                   String                   @id @default(uuid()) @db.Uuid
  conversationId       String                   @db.Uuid
  organisationId       String                   @db.Uuid
  assigneeType         ConversationAssigneeType
  aiEmployeeId         String?                  @db.Uuid
  organisationMemberId String?                  @db.Uuid
  reason               String?
  actorUserId          String?                  @db.Uuid
  createdAt            DateTime                 @default(now())
  conversation         Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organisation         Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member               OrganisationMember?      @relation("ConversationAssignmentMember", fields: [organisationMemberId], references: [id], onDelete: SetNull)
  actor                User?                    @relation("ConversationAssignmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([organisationId, createdAt])
}

model CommunicationChannelConfig {
  id                 String              @id @default(uuid()) @db.Uuid
  organisationId     String              @db.Uuid
  channel            ConversationChannel
  enabled            Boolean             @default(false)
  providerKey        String?
  fromAddress        String?
  webhookVerifyToken String?
  config             Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, channel])
}

// ---------------------------------------------------------------------------
// Phase 19 - Provider-neutral object storage, generated documents, e-signature,
// geocoding, calendar, and organisation integration health.
// ---------------------------------------------------------------------------

enum StorageClassification {
  PRIVATE
  PUBLIC
}

enum StorageOrigin {
  UPLOADED
  GENERATED
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

enum StorageArchiveAction {
  ARCHIVED
  RESTORED
}

enum GeneratedDocumentType {
  RECEIPT
  TENANT_STATEMENT
  MOVE_OUT_STATEMENT
  LEASE_AGREEMENT
}

enum SignatureEventStatus {
  MATCHED
  UNMATCHED
  MISMATCHED
  DUPLICATE
}

enum GeocodeStatus {
  NOT_ATTEMPTED
  OK
  NOT_FOUND
  ERROR
  NOT_CONFIGURED
}

enum CalendarEventType {
  VIEWING
  MOVE_IN
  MOVE_OUT
  INSPECTION
  MAINTENANCE_APPOINTMENT
}

enum CalendarEventStatus {
  SCHEDULED
  UPDATED
  CANCELLED
}

enum CalendarSyncStatus {
  NOT_APPLICABLE
  SYNCED
  PENDING
  FAILED
}

enum IntegrationType {
  STORAGE
  ESIGNATURE
  GEOCODING
  CALENDAR
  MALWARE_SCAN
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  DEGRADED
  ERROR
}

/// Canonical, provider-neutral metadata for every stored file byte-blob (uploaded or generated).
/// The actual bytes never live in the database: `storageKey` is the only pointer into whichever
/// `ObjectStorageAdapter` is configured (S3-compatible in production, filesystem/in-memory when
/// no credentials are configured). `organisationId` is nullable because an individually-owned
/// (non company-backed) service provider's verification evidence has no owning organisation —
/// every other target type always sets it, and every organisation-scoped query filters on it.
model StorageObject {
  id                  String                 @id @default(uuid()) @db.Uuid
  organisationId      String?                @db.Uuid
  storageKey          String                 @unique
  origin              StorageOrigin
  classification      StorageClassification  @default(PRIVATE)
  targetType          String
  targetId            String?                @db.Uuid
  originalFileName    String
  safeFileName        String
  declaredContentType String?
  contentType         String
  sizeBytes           Int
  sha256              String
  uploadedByUserId    String?                @db.Uuid
  malwareScanStatus   MalwareScanStatus      @default(SKIPPED)
  malwareScanDetail   String?
  malwareScannedAt    DateTime?
  archivedAt          DateTime?
  archivedByUserId    String?                @db.Uuid
  archiveReason       String?
  metadata            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  organisation        Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  uploadedBy          User?                  @relation("StorageObjectUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  archivedBy          User?                  @relation("StorageObjectArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  history             StorageObjectHistory[]
  generatedDocument   GeneratedDocument?

  @@index([organisationId, targetType, targetId])
  @@index([organisationId, classification, archivedAt])
  @@index([organisationId, createdAt])
}

/// Append-only archive/restore audit trail for a `StorageObject` (item 1's "archive policy/history").
model StorageObjectHistory {
  id              String               @id @default(uuid()) @db.Uuid
  storageObjectId String               @db.Uuid
  actorUserId     String?              @db.Uuid
  action          StorageArchiveAction
  reason          String?
  createdAt       DateTime             @default(now())
  storageObject   StorageObject        @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  actor           User?                @relation("StorageObjectHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([storageObjectId, createdAt])
}

/// An immutable, versioned generated PDF (receipt/statement/lease document) backed 1:1 by a
/// `StorageObject`. `dataHash` is a checksum of the exact source-record snapshot rendered into the
/// PDF: requesting generation again with unchanged source data returns the existing row instead of
/// ever re-rendering or overwriting it; a genuinely changed snapshot creates a new `version` while
/// every previous version's bytes remain retrievable forever.
model GeneratedDocument {
  id                   String                @id @default(uuid()) @db.Uuid
  organisationId       String                @db.Uuid
  storageObjectId      String                @unique @db.Uuid
  documentType         GeneratedDocumentType
  referenceNumber      String                @unique
  version              Int                   @default(1)
  sourceType           String
  sourceId             String                @db.Uuid
  dataHash             String
  leaseId              String?               @db.Uuid
  tenantOrganisationId String?               @db.Uuid
  propertyId           String?               @db.Uuid
  generatedByUserId    String?               @db.Uuid
  generatedAt          DateTime              @default(now())
  supersededAt         DateTime?
  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  storageObject        StorageObject         @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  lease                Lease?                @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenantOrganisation   TenantOrganisation?   @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)
  property             Property?             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  generatedBy          User?                 @relation("GeneratedDocumentCreator", fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organisationId, documentType, sourceType, sourceId, dataHash])
  @@index([organisationId, documentType, sourceType, sourceId, version])
  @@index([leaseId])
  @@index([tenantOrganisationId])
  @@index([propertyId])
}

/// An organisation's own configurable legal template for a generated document type (currently
/// meaningful for LEASE_AGREEMENT). PropertyOS never invents or ships jurisdiction-specific legal
/// clauses: when no active template exists, lease document generation falls back to a neutral,
/// factual-only summary of the real lease record and reports `templateConfigured: false`.
model DocumentTemplate {
  id              String                @id @default(uuid()) @db.Uuid
  organisationId  String                @db.Uuid
  documentType    GeneratedDocumentType
  name            String
  bodyTemplate    String
  isActive        Boolean               @default(true)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("DocumentTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organisationId, documentType])
}

/// Idempotency/replay-prevention ledger for inbound e-signature provider webhooks, mirroring
/// `PaymentReconciliationEvent`'s (providerKey, eventKey) uniqueness so a redelivered webhook is
/// recognised and never re-applied.
model SignatureProviderEvent {
  id                 String                 @id @default(uuid()) @db.Uuid
  organisationId     String                 @db.Uuid
  providerKey        String
  eventKey           String
  payloadHash        String
  signatureRequestId String?                @db.Uuid
  status             SignatureEventStatus
  receivedAt         DateTime               @default(now())
  processedAt        DateTime?
  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  signatureRequest   LeaseSignatureRequest? @relation(fields: [signatureRequestId], references: [id], onDelete: Restrict)

  @@unique([providerKey, eventKey])
  @@index([organisationId, receivedAt])
  @@index([signatureRequestId])
}

/// Log/cache of address geocoding attempts. `Property.latitude`/`longitude` hold the current
/// precise (private) result; this table keeps the attempt history (status/provider/failure
/// reason) so a property without coordinates can explain why, and repeated identical queries can
/// be recognised without re-billing a paid provider.
model GeocodeLookup {
  id                String        @id @default(uuid()) @db.Uuid
  organisationId    String        @db.Uuid
  propertyId        String?       @db.Uuid
  provider          String
  queryText         String
  queryHash         String
  status            GeocodeStatus
  latitude          Decimal?      @db.Decimal(10, 7)
  longitude         Decimal?      @db.Decimal(10, 7)
  precision         String?
  providerReference String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  organisation      Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property          Property?     @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([organisationId, queryHash])
  @@index([propertyId, createdAt])
}

/// A provider-neutral scheduled event (viewing/move-in/move-out/inspection/maintenance
/// appointment). The row itself is the source of truth for scheduling — `syncStatus`/
/// `lastSyncError` track a best-effort external calendar mirror and never gate core scheduling.
model CalendarEvent {
  id                String              @id @default(uuid()) @db.Uuid
  organisationId    String              @db.Uuid
  type              CalendarEventType
  sourceType        String
  sourceId          String              @db.Uuid
  title             String
  description       String?
  startAt           DateTime
  endAt             DateTime
  timezone          String
  location          String?
  attendees         Json                @default("[]")
  status            CalendarEventStatus @default(SCHEDULED)
  providerKey       String              @default("INTERNAL")
  providerEventId   String?
  syncStatus        CalendarSyncStatus  @default(SYNCED)
  lastSyncError     String?
  lastSyncAttemptAt DateTime?
  createdByUserId   String?             @db.Uuid
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organisation      Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy         User?               @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organisationId, sourceType, sourceId, type])
  @@index([organisationId, startAt])
  @@index([organisationId, type, status])
}

/// Organisation-scoped configuration/health for a Phase 19 integration category. Never stores raw
/// secrets (those stay env-only); `metadata` is restricted to non-secret operational fields such
/// as a bucket name or base URL. `status`/`lastSuccessAt`/`lastFailureAt` are maintained by the
/// adapters themselves as they are used, giving a real health signal instead of a static flag.
model IntegrationConfig {
  id                String            @id @default(uuid()) @db.Uuid
  organisationId    String            @db.Uuid
  integrationType   IntegrationType
  provider          String
  enabled           Boolean           @default(true)
  metadata          Json              @default("{}")
  status            IntegrationStatus @default(NOT_CONFIGURED)
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastFailureReason String?
  updatedByUserId   String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  updatedBy         User?             @relation("IntegrationConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organisationId, integrationType])
}

// ---------------------------------------------------------------------------
// Phase 20: commercial SaaS subscriptions, a single entitlement service, and
// an explicit NesAfric platform-administration boundary. Every model below is
// additive to the existing schema (no Phase 1-19 model changes beyond the
// `ReminderEventType` values and back-relations above) and preserves existing
// domain identity: `OrganisationSubscription` is a 1:1 attribute of the
// existing `Organisation`, never a duplicate tenant/account concept.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum EntitlementKind {
  BOOLEAN
  LIMIT
}

enum SubscriptionInvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
}

/// Mirrors `ReconciliationStatus`/`SignatureEventStatus`'s idempotent-webhook-ledger vocabulary
/// for the provider-neutral SaaS billing webhook (item 5).
enum BillingWebhookStatus {
  PROCESSED
  UNMATCHED
  MISMATCHED
  DUPLICATE
  FAILED
}

/// Platform-administration roles (item 8). Deliberately a small closed set evaluated in code
/// (`src/platform/platform-admin/permissions.ts`), not the DB-driven `Role`/`Permission` tables
/// used for organisation RBAC — the two authorization systems must never share plumbing.
enum PlatformRole {
  SUPER_ADMIN
  BILLING_ADMIN
  SUPPORT_AGENT
  READ_ONLY
}

enum PlatformPrincipalStatus {
  ACTIVE
  DISABLED
}

/// How a `PlatformPrincipal` came to exist: only ever env-variable bootstrap or a manual,
/// operator-run script. No API endpoint in this application creates or promotes one.
enum PlatformPrincipalOrigin {
  ENV_BOOTSTRAP
  MANUAL
}

/// A configurable, sellable plan tier (item 1). Prices and entitlements are separate child
/// tables so the same plan can be priced in several currencies/cycles and carry many
/// boolean/limit entitlements without a wide, sparse column set.
model SubscriptionPlan {
  id            String                     @id @default(uuid()) @db.Uuid
  key           String                     @unique
  name          String
  description   String?
  isActive      Boolean                    @default(true)
  isPublic      Boolean                    @default(true)
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  subscriptions OrganisationSubscription[]
  invoices      SubscriptionInvoice[]

  @@index([isActive, isPublic, sortOrder])
}

/// One price point for a plan in a given currency/billing cycle (item 1's "configurable...
/// prices/currencies"). `currencyCode` is a plain code (not a Prisma relation), matching every
/// other currency-code field in this schema (e.g. `Organisation.defaultCurrencyCode`).
model PlanPrice {
  id           String           @id @default(uuid()) @db.Uuid
  planId       String           @db.Uuid
  currencyCode String           @db.Char(3)
  billingCycle BillingCycle
  amountMinor  Decimal          @db.Decimal(19, 0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currencyCode, billingCycle])
}

/// One boolean or numeric-limit entitlement for a plan (item 2). `isUnlimited` is an explicit
/// flag rather than overloading a null `limitValue`, so "unlimited" and "not configured" can
/// never be confused.
model PlanEntitlement {
  id           String           @id @default(uuid()) @db.Uuid
  planId       String           @db.Uuid
  featureKey   String
  kind         EntitlementKind
  booleanValue Boolean?
  limitValue   BigInt?
  isUnlimited  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

/// The single subscription attribute of an existing `Organisation` (item 1) — a 1:1 relation,
/// never a second tenant identity. Carries plan/cycle/currency, provider-neutral billing
/// customer/subscription refs, every lifecycle timestamp (item 4), and the current billing
/// period entitlement usage windows are computed against.
model OrganisationSubscription {
  id                     String                      @id @default(uuid()) @db.Uuid
  organisationId         String                      @unique @db.Uuid
  planId                 String                      @db.Uuid
  status                 SubscriptionStatus          @default(TRIALING)
  billingCycle           BillingCycle                @default(MONTHLY)
  currencyCode           String                      @db.Char(3)
  billingProviderKey     String                      @default("test")
  billingCustomerRef     String?
  billingSubscriptionRef String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean                     @default(false)
  cancelledAt            DateTime?
  suspendedAt            DateTime?
  gracePeriodEndsAt      DateTime?
  pastDueSince           DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  organisation           Organisation                @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  plan                   SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices               SubscriptionInvoice[]
  statusHistory          SubscriptionStatusHistory[]

  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@index([billingProviderKey, billingSubscriptionRef])
}

/// A billing period rendered as an invoice (item 1's "periods/history/invoices" combined into
/// one queryable row per period, mirroring how e.g. `ListingStatusHistory` doubles as both
/// history and the queryable current state elsewhere in this schema).
model SubscriptionInvoice {
  id                 String                    @id @default(uuid()) @db.Uuid
  organisationId     String                    @db.Uuid
  subscriptionId     String                    @db.Uuid
  planId             String                    @db.Uuid
  periodStart        DateTime
  periodEnd          DateTime
  amountMinor        Decimal                   @db.Decimal(19, 0)
  currencyCode       String                    @db.Char(3)
  status             SubscriptionInvoiceStatus @default(OPEN)
  billingProviderKey String
  providerInvoiceRef String?
  issuedAt           DateTime                  @default(now())
  dueAt              DateTime?
  paidAt             DateTime?
  failureReason      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  organisation       Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  subscription       OrganisationSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan               SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, periodStart])
  @@unique([billingProviderKey, providerInvoiceRef])
  @@index([organisationId, status])
}

/// Append-only subscription lifecycle audit trail (item 4's "events/audit actor attribution"),
/// distinct from the generic `AuditEvent`/`DomainEvent` tables (which every lifecycle transition
/// also writes to, exactly like every other domain in this schema) because it is structured
/// enough to query a subscription's full status timeline directly, and records which side (an
/// organisation user, a platform principal, or an automated job) actually caused the change.
model SubscriptionStatusHistory {
  id                       String                   @id @default(uuid()) @db.Uuid
  subscriptionId           String                   @db.Uuid
  organisationId           String                   @db.Uuid
  fromStatus               SubscriptionStatus?
  toStatus                 SubscriptionStatus
  reason                   String
  actorUserId              String?                  @db.Uuid
  actorPlatformPrincipalId String?                  @db.Uuid
  createdAt                DateTime                 @default(now())
  subscription             OrganisationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  organisation             Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actorUser                User?                    @relation("SubscriptionStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPlatformPrincipal   PlatformPrincipal?       @relation(fields: [actorPlatformPrincipalId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([subscriptionId, createdAt])
}

/// A platform-granted, time-bound, per-organisation entitlement override (item 2's "org/
/// promotional overrides"), e.g. a temporary limit raise or a comped boolean feature. Always
/// takes precedence over the organisation's plan entitlement for the same `featureKey` while
/// active (not expired, not revoked). Never deletes the plan entitlement it overrides.
model OrganisationEntitlementOverride {
  id                           String             @id @default(uuid()) @db.Uuid
  organisationId               String             @db.Uuid
  featureKey                   String
  kind                         EntitlementKind
  booleanValue                 Boolean?
  limitValue                   BigInt?
  isUnlimited                  Boolean            @default(false)
  reason                       String
  expiresAt                    DateTime?
  createdByPlatformPrincipalId String             @db.Uuid
  revokedAt                    DateTime?
  revokedByPlatformPrincipalId String?            @db.Uuid
  createdAt                    DateTime           @default(now())
  organisation                 Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdByPlatformPrincipal   PlatformPrincipal  @relation("OverrideCreator", fields: [createdByPlatformPrincipalId], references: [id], onDelete: Restrict)
  revokedByPlatformPrincipal   PlatformPrincipal? @relation("OverrideRevoker", fields: [revokedByPlatformPrincipalId], references: [id], onDelete: SetNull)

  @@index([organisationId, featureKey, revokedAt])
}

/// Idempotency/replay-prevention ledger for inbound SaaS-billing provider webhooks (item 5),
/// mirroring `PaymentReconciliationEvent`/`SignatureProviderEvent` exactly: a redelivered webhook
/// is recognised by `(providerKey, eventKey)` and never re-applied. `organisationId` is nullable
/// because a webhook can arrive referencing a billing customer/subscription ref this instance
/// does not (yet) recognise (`UNMATCHED`), which must still be durably recorded.
model BillingWebhookEvent {
  id             String               @id @default(uuid()) @db.Uuid
  organisationId String?              @db.Uuid
  providerKey    String
  eventKey       String
  eventType      String
  payloadHash    String
  status         BillingWebhookStatus
  failureReason  String?
  receivedAt     DateTime             @default(now())
  processedAt    DateTime?
  organisation   Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@unique([providerKey, eventKey])
  @@index([organisationId, receivedAt])
}

/// The explicit NesAfric platform-administration principal (item 8) — completely independent of
/// `OrganisationMember`/`Role`/`Permission`. Linked 1:1 to a `User` purely to reuse the existing
/// login/session mechanism; having an `OrganisationMember` row never implies this, and vice
/// versa. Only ever created by `ensurePlatformBootstrap()` (env-variable driven) or a manual,
/// operator-run script — no HTTP endpoint in this application can create or promote one.
model PlatformPrincipal {
  id                        String                            @id @default(uuid()) @db.Uuid
  userId                    String                            @unique @db.Uuid
  role                      PlatformRole
  status                    PlatformPrincipalStatus           @default(ACTIVE)
  createdVia                PlatformPrincipalOrigin
  notes                     String?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  disabledAt                DateTime?
  user                      User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  supportSessions           PlatformSupportSession[]
  auditEvents               PlatformAuditEvent[]
  overridesCreated          OrganisationEntitlementOverride[] @relation("OverrideCreator")
  overridesRevoked          OrganisationEntitlementOverride[] @relation("OverrideRevoker")
  flagOverridesCreated      OrganisationFeatureFlagOverride[]
  flagsUpdated              FeatureFlag[]
  subscriptionStatusActions SubscriptionStatusHistory[]

  @@index([role, status])
}

/// An audited, time-bound, read-only support access grant (item 9): reason/admin/target/expiry.
/// Deliberately has no relation to `OrganisationMember` and grants no mutation capability of its
/// own — it is the durable, organisation-visible record that justifies a platform principal
/// viewing a specific organisation's detail through the (already read-only) platform-admin APIs.
model PlatformSupportSession {
  id                  String            @id @default(uuid()) @db.Uuid
  platformPrincipalId String            @db.Uuid
  organisationId      String            @db.Uuid
  reason              String
  startedAt           DateTime          @default(now())
  expiresAt           DateTime
  endedAt             DateTime?
  revokedAt           DateTime?
  createdAt           DateTime          @default(now())
  platformPrincipal   PlatformPrincipal @relation(fields: [platformPrincipalId], references: [id], onDelete: Restrict)
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, expiresAt])
  @@index([platformPrincipalId, expiresAt])
}

/// Platform-side append-only audit trail (item 8), the counterpart of the organisation-scoped
/// `AuditEvent` for actions a platform principal takes (viewing an org, changing a plan,
/// suspending a subscription, editing a feature flag) — kept fully separate so organisation
/// members never see platform-principal identities mixed into their own audit history.
model PlatformAuditEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  platformPrincipalId String?            @db.Uuid
  action              String
  entityType          String
  entityId            String
  organisationId      String?            @db.Uuid
  metadata            Json?
  createdAt           DateTime           @default(now())
  platformPrincipal   PlatformPrincipal? @relation(fields: [platformPrincipalId], references: [id], onDelete: SetNull)
  organisation        Organisation?      @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([action, createdAt])
}

/// A platform-wide feature flag (item 10), fully separate from organisation RBAC. Evaluation
/// order (see `src/modules/feature-flags/service.ts`): `emergencyDisabled` always wins (forces
/// off); otherwise an active `OrganisationFeatureFlagOverride` wins; otherwise a deterministic
/// percentage-cohort hash of `(organisationId, key)` against `rolloutPercentage`; otherwise
/// `isEnabled`.
model FeatureFlag {
  id                           String                            @id @default(uuid()) @db.Uuid
  key                          String                            @unique
  description                  String
  isEnabled                    Boolean                           @default(false)
  rolloutPercentage            Int                               @default(100)
  emergencyDisabled            Boolean                           @default(false)
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  updatedByPlatformPrincipalId String?                           @db.Uuid
  updatedByPlatformPrincipal   PlatformPrincipal?                @relation(fields: [updatedByPlatformPrincipalId], references: [id], onDelete: SetNull)
  organisationOverrides        OrganisationFeatureFlagOverride[]
}

/// A per-organisation override of a `FeatureFlag`'s evaluated result (item 10).
model OrganisationFeatureFlagOverride {
  id                           String             @id @default(uuid()) @db.Uuid
  organisationId               String             @db.Uuid
  flagKey                      String
  enabled                      Boolean
  createdAt                    DateTime           @default(now())
  createdByPlatformPrincipalId String?            @db.Uuid
  organisation                 Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  flag                         FeatureFlag        @relation(fields: [flagKey], references: [key], onDelete: Restrict)
  createdByPlatformPrincipal   PlatformPrincipal? @relation(fields: [createdByPlatformPrincipalId], references: [id], onDelete: SetNull)

  @@unique([organisationId, flagKey])
}

// =============================================================================
// Phase 21A — Real Estate Marketplace Professional Foundation
// =============================================================================
// A completely distinct account family from PropertyOS management organisations (see the
// `Organisation.marketplaceProfessional` doc comment above). One `User` may hold memberships in
// any number of PropertyOS management organisations AND any number of `MarketplaceProfessional`
// profiles simultaneously (item 7's "dual-workspace accounts") — the two are never conflated,
// never share a subscription/entitlement track, and a marketplace-only account is never granted
// PropertyOS management screens or permissions.

/// Extensible — new professional/business categories can be added without a migration touching
/// existing rows (item 1).
enum MarketplaceProfessionalType {
  INDIVIDUAL_AGENT
  BROKER
  BROKERAGE
  REAL_ESTATE_COMPANY
  DEVELOPER
  PROPERTY_MARKETING_COMPANY
  OTHER
}

enum MarketplaceProfessionalStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Deliberately the same vocabulary as `ListingVerificationStatus`/provider verification
/// elsewhere in this schema, kept as its own enum so marketplace-professional verification can
/// evolve independently of either.
enum MarketplaceVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

/// Company/team structure (item 2). OWNER created the profile (or was granted ownership) and can
/// manage billing/team/verification; ADMIN can manage team/listings/developments but not
/// ownership; AGENT operates within the company (listings, leads, viewings) without team-management
/// authority. Deliberately a flat, ordered enum rather than the full `Permission`/`Role` engine —
/// marketplace team roles are simple by design (see `requireMarketplaceRole`).
enum MarketplaceMemberRole {
  OWNER
  ADMIN
  AGENT
}

enum MarketplaceMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

/// Item 4/5 — the relationship between the party marketing a listing and the underlying asset.
/// Never assumes the listing party owns the property.
enum ListingAuthority {
  OWNER_SELF
  PROPERTY_MANAGER
  MANAGING_AGENT
  BROKERAGE_AUTHORIZED
  DEVELOPER
  THIRD_PARTY_AUTHORIZED
}

enum DevelopmentStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
  HANDED_OVER
  ARCHIVED
}

enum DevelopmentUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  UNAVAILABLE
}

/// The professional/business marketplace identity (item 1): an individual agent, broker,
/// brokerage, real-estate company, developer, or property-marketing company. Backed by a hidden,
/// technical `Organisation` (`backingOrganisationId`) purely so listing/lead/viewing creation can
/// reuse the existing, already-isolated Listing/MarketplaceLead/ViewingRequest domains (item 5,
/// "reuse existing... architecture... do not create competing duplicate domains") without ever
/// surfacing PropertyOS management screens to a marketplace-only account (item 6/11) or attaching
/// a PropertyOS management subscription (item 8) — the backing organisation intentionally has no
/// `OrganisationSubscription` row.
model MarketplaceProfessional {
  id                             String                        @id @default(uuid()) @db.Uuid
  backingOrganisationId          String                        @unique @db.Uuid
  type                           MarketplaceProfessionalType
  displayName                    String
  legalName                      String?
  /// Public profile URL segment (item 10): `/marketplace/professionals/{slug}`.
  slug                           String                        @unique
  logoUrl                        String?
  description                    String?
  websiteUrl                     String?
  contactEmail                   String?
  contactPhone                   String?
  countryCode                    String                        @db.Char(2)
  /// Free-form readiness fields (item 1/10): specialities/categories, services offered, and
  /// service areas. Deliberately simple scalar arrays rather than new join tables for this
  /// foundation phase — extensible to a controlled taxonomy later without a breaking change.
  specialities                   String[]
  servicesOffered                String[]
  serviceAreas                   String[]
  status                         MarketplaceProfessionalStatus @default(ACTIVE)
  verificationStatus             MarketplaceVerificationStatus @default(UNVERIFIED)
  /// Evidence *references* only (item 1's "verification evidence readiness") — no file storage
  /// integration in this foundation phase, matching how Phase 8 provider evidence started.
  verificationEvidenceReferences String[]
  createdByUserId                String                        @db.Uuid
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  archivedAt                     DateTime?

  backingOrganisation  Organisation                               @relation(fields: [backingOrganisationId], references: [id], onDelete: Restrict)
  createdBy            User                                       @relation("MarketplaceProfessionalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members              MarketplaceProfessionalMember[]
  verificationHistory  MarketplaceProfessionalVerificationEvent[]
  developments         Development[]
  listings             Listing[]
  marketplaceAssets    MarketplaceAsset[]
  subscription         MarketplaceSubscription?
  aiemployees          AIEmployee[]
  aiEmployeeActivities AIEmployeeActivity[]
  aiEmployeeHandoffs   AIEmployeeHandoff[]
  campaigns            Campaign[]

  @@index([type, status])
  @@index([verificationStatus])
  @@index([countryCode])
}

/// Company/team structure (item 2): who may act on behalf of a `MarketplaceProfessional`.
model MarketplaceProfessionalMember {
  id                        String                  @id @default(uuid()) @db.Uuid
  marketplaceProfessionalId String                  @db.Uuid
  userId                    String                  @db.Uuid
  role                      MarketplaceMemberRole
  status                    MarketplaceMemberStatus @default(ACTIVE)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  marketplaceProfessional MarketplaceProfessional @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Cascade)
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedHandoffs        AIEmployeeHandoff[]

  @@unique([marketplaceProfessionalId, userId])
  @@index([userId, status])
}

/// Append-only verification-status audit trail (item 1 + item 11's "audit attribution"), the same
/// pattern as `ProviderVerificationHistory`/`ListingVerificationHistory` elsewhere in this schema.
model MarketplaceProfessionalVerificationEvent {
  id                        String                         @id @default(uuid()) @db.Uuid
  marketplaceProfessionalId String                         @db.Uuid
  fromStatus                MarketplaceVerificationStatus?
  toStatus                  MarketplaceVerificationStatus
  reason                    String?
  actorUserId               String?                        @db.Uuid
  createdAt                 DateTime                       @default(now())

  marketplaceProfessional MarketplaceProfessional @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Cascade)
  actorUser               User?                   @relation("MarketplaceProfessionalVerificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([marketplaceProfessionalId, createdAt])
}

/// A developer's project (item 3). Deliberately does not require any PropertyOS `Property`/`Unit`
/// backing — a developer may participate in the marketplace without ever subscribing to
/// PropertyOS management (item 8). Not a construction-management ERP: no cost tracking, no
/// contractor/procurement workflow, just enough structure to showcase a project and its
/// sellable/rentable inventory.
model Development {
  id                        String            @id @default(uuid()) @db.Uuid
  marketplaceProfessionalId String            @db.Uuid
  name                      String
  description               String?
  status                    DevelopmentStatus @default(PLANNING)
  countryCode               String            @db.Char(2)
  region                    String?
  city                      String?
  district                  String?
  addressLine1              String?
  latitude                  Decimal?          @db.Decimal(10, 7)
  longitude                 Decimal?          @db.Decimal(10, 7)
  amenities                 String[]
  mediaUrls                 String[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  archivedAt                DateTime?

  marketplaceProfessional MarketplaceProfessional @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Cascade)
  units                   DevelopmentUnit[]
  listings                Listing[]
  phoneNumbers            PhoneNumber[]

  @@index([marketplaceProfessionalId, status])
  @@index([countryCode, city])
}

/// A single sellable/rentable inventory item within a `Development` (item 3's "units/property
/// inventory"). `status` is the source of truth for availability; a `DevelopmentUnit` may
/// optionally be published as a full marketplace `Listing` (see `Listing.developmentUnitId`) once
/// it is ready to receive public enquiries/leads/viewings through the existing Listing pipeline.
model DevelopmentUnit {
  id            String                @id @default(uuid()) @db.Uuid
  developmentId String                @db.Uuid
  name          String
  unitType      String?
  status        DevelopmentUnitStatus @default(AVAILABLE)
  bedrooms      Int?
  bathrooms     Decimal?              @db.Decimal(4, 1)
  sizeSqm       Decimal?              @db.Decimal(12, 2)
  priceMinor    Decimal?              @db.Decimal(19, 0)
  currencyCode  String?               @db.Char(3)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  archivedAt    DateTime?

  development      Development       @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  listings         Listing[]
  marketplaceAsset MarketplaceAsset?

  @@index([developmentId, status])
}

/// Mirrors `SubscriptionPlan` (Phase 20) for the marketplace's own, entirely separate commercial
/// product family (item 8). Never referenced by `OrganisationSubscription`.
model MarketplacePlan {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices        MarketplacePlanPrice[]
  entitlements  MarketplacePlanEntitlement[]
  subscriptions MarketplaceSubscription[]

  @@index([isActive, isPublic, sortOrder])
}

/// Mirrors `PlanPrice`. At launch only a GHS 0 `MONTHLY` row exists for the free plan (item 8) —
/// this table exists so a real price can be introduced for a future paid tier without a schema
/// change ("do not hard-code marketplace professionals never pay").
model MarketplacePlanPrice {
  id           String       @id @default(uuid()) @db.Uuid
  planId       String       @db.Uuid
  currencyCode String       @db.Char(3)
  billingCycle BillingCycle
  amountMinor  Decimal      @db.Decimal(19, 0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  plan MarketplacePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currencyCode, billingCycle])
}

/// Mirrors `PlanEntitlement`. Feature keys are marketplace-specific (active listings, team
/// members, developments, promoted/featured placement, etc.) and validated against their own
/// catalog (`src/modules/marketplace-professionals/entitlements.ts`), kept separate from the
/// PropertyOS `ENTITLEMENTS` catalog (item 8).
model MarketplacePlanEntitlement {
  id           String          @id @default(uuid()) @db.Uuid
  planId       String          @db.Uuid
  featureKey   String
  kind         EntitlementKind
  booleanValue Boolean?
  limitValue   BigInt?
  isUnlimited  Boolean         @default(false)

  plan MarketplacePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

/// Mirrors `OrganisationSubscription`'s shape but is a fully separate table, FK'd to
/// `MarketplaceProfessional` instead of `Organisation` (item 8: never the same commercial track
/// as a PropertyOS management subscription). Every `MarketplaceProfessional` gets exactly one of
/// these, defaulted to the free plan at `ACTIVE` (not `TRIALING` — the free tier does not expire).
model MarketplaceSubscription {
  id                        String             @id @default(uuid()) @db.Uuid
  marketplaceProfessionalId String             @unique @db.Uuid
  planId                    String             @db.Uuid
  status                    SubscriptionStatus @default(ACTIVE)
  billingCycle              BillingCycle       @default(MONTHLY)
  currencyCode              String             @db.Char(3)
  cancelAtPeriodEnd         Boolean            @default(false)
  cancelledAt               DateTime?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  marketplaceProfessional MarketplaceProfessional @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Restrict)
  plan                    MarketplacePlan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([planId])
}

// =============================================================================
// Phase 21 — AI Maintenance Dispatch foundation (items 16-19)
// =============================================================================

/// Structured dispatch status, ready for Phase 22 voice-call integration. No telephony exists
/// yet — `CONTACTED` today means a deterministic notification (in-app/message) was sent, not a
/// phone call.
enum DispatchAttemptStatus {
  CONTACT_PENDING
  CONTACTED
  ACCEPTED
  DECLINED
  NO_RESPONSE
  BACKUP_REQUIRED
  ASSIGNED
}

/// One attempt to dispatch a work order to a provider, in hierarchy order (item 17: private/
/// assigned -> preferred -> backup -> NesAfric marketplace fallback). Multiple rows accumulate as
/// the dispatch engine escalates through the hierarchy (item 18: "first provider does not respond
/// within X minutes -> contact backup").
model MaintenanceDispatchAttempt {
  id                      String                @id @default(uuid()) @db.Uuid
  organisationId          String                @db.Uuid
  workOrderId             String                @db.Uuid
  maintenanceRequestId    String                @db.Uuid
  tier                    String
  serviceProviderId       String?               @db.Uuid
  status                  DispatchAttemptStatus @default(CONTACT_PENDING)
  reason                  String?
  contactedAt             DateTime?
  respondedAt             DateTime?
  initiatedByAIEmployeeId String?               @db.Uuid
  createdByUserId         String?               @db.Uuid
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organisation          Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  workOrder             WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  maintenanceRequest    MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Restrict)
  serviceProvider       ServiceProvider?   @relation(fields: [serviceProviderId], references: [id], onDelete: Restrict)
  initiatedByAIEmployee AIEmployee?        @relation(fields: [initiatedByAIEmployeeId], references: [id], onDelete: SetNull)
  createdBy             User?              @relation("MaintenanceDispatchAttemptCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voiceCalls            VoiceCall[]

  @@index([organisationId, status, createdAt])
  @@index([workOrderId, createdAt])
  @@index([serviceProviderId, status])
}

/// Phase 21B (items 18-23): the central NesAfric campaign & promotion system. Deliberately one
/// model covering both NesAfric-owned announcements (`isPlatformOwned`, e.g. the thin homepage
/// announcement bar) and marketplace-professional self-service promotion requests
/// (`advertiserMarketplaceProfessionalId`) — the two are distinguished by placement and ownership,
/// never by separate tables, so platform review/scheduling/analytics is uniform across both.
enum CampaignPlacement {
  /// The one homepage placement (item 18/24): a small dismissible announcement bar,
  /// NesAfric-owned only — never available to `createCampaign` (self-service).
  HOMEPAGE_ANNOUNCEMENT
  MARKETPLACE_PRIMARY
  MARKETPLACE_INLINE
  DEVELOPMENT_FEATURED
  PROFESSIONAL_FEATURED
  SEARCH_FEATURED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  ARCHIVED
}

model Campaign {
  id                                  String            @id @default(uuid()) @db.Uuid
  name                                String
  placement                           CampaignPlacement
  status                              CampaignStatus    @default(DRAFT)
  priority                            Int               @default(0)
  headline                            String
  supportingText                      String?
  ctaLabel                            String?
  destinationUrl                      String
  desktopMediaUrl                     String?
  mobileMediaUrl                      String?
  countryCode                         String?           @db.Char(2)
  region                              String?
  startAt                             DateTime?
  endAt                               DateTime?
  impressionCount                     Int               @default(0)
  clickCount                          Int               @default(0)
  /// NesAfric-owned campaigns (homepage announcements, platform-curated marketplace placements)
  /// have no advertiser; self-service submissions from a marketplace professional always do.
  isPlatformOwned                     Boolean           @default(false)
  advertiserMarketplaceProfessionalId String?           @db.Uuid
  createdByUserId                     String            @db.Uuid
  reviewedByUserId                    String?           @db.Uuid
  reviewedAt                          DateTime?
  rejectionReason                     String?
  createdAt                           DateTime          @default(now())
  updatedAt                           DateTime          @updatedAt
  archivedAt                          DateTime?

  advertiser MarketplaceProfessional? @relation(fields: [advertiserMarketplaceProfessionalId], references: [id], onDelete: Cascade)
  createdBy  User                     @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?                    @relation("CampaignReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([placement, status, priority])
  @@index([advertiserMarketplaceProfessionalId])
}

// ---------------------------------------------------------------------------
// Phase 22 - AI Voice Receptionist + Voice Sales + Artisan Calling
// ---------------------------------------------------------------------------

enum VoiceCallDirection {
  INBOUND
  OUTBOUND
}

enum VoiceCallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
}

enum VoiceCallOutcome {
  NONE
  INFORMATION_PROVIDED
  LEAD_CAPTURED
  VIEWING_SCHEDULED
  MAINTENANCE_REQUEST_CREATED
  ARTISAN_ACCEPTED
  ARTISAN_DECLINED
  ARTISAN_NO_RESPONSE
  HANDED_OFF_TO_HUMAN
  NO_ACTION
  FAILED
}

enum VoiceConsentStatus {
  NOT_REQUIRED
  PENDING
  GRANTED
  DECLINED
}

/// Provider-neutral per-organisation voice configuration (item 1/15). Exactly one row per
/// `organisationId` — for a Marketplace professional this is their hidden backing organisation,
/// the same indirection every other marketplace-scoped domain already uses (no separate
/// `marketplaceProfessionalId` column needed here).
model VoiceProviderConfig {
  id                             String   @id @default(uuid()) @db.Uuid
  organisationId                 String   @unique @db.Uuid
  providerKey                    String   @default("MOCK")
  phoneNumber                    String?
  inboundEnabled                 Boolean  @default(true)
  outboundEnabled                Boolean  @default(false)
  timezone                       String   @default("UTC")
  /// "HH:MM" 24-hour, evaluated in `timezone` (item 15).
  businessHoursStart             String   @default("08:00")
  businessHoursEnd               String   @default("18:00")
  maxRetryAttempts               Int      @default(2)
  retryDelaySeconds              Int      @default(900)
  maxOutboundCallsPerDay         Int      @default(50)
  recordingEnabled               Boolean  @default(false)
  consentRequired                Boolean  @default(true)
  status                         String   @default("ACTIVE")
  /// Phase 22B item 2 — which registered speech provider adapters handle this organisation's
  /// calls. Independent of `providerKey` (telephony transport) since STT/TTS/telephony are three
  /// separately swappable provider-neutral concerns.
  sttProviderKey                 String   @default("MOCK")
  ttsProviderKey                 String   @default("MOCK")
  /// Phase 22B item 12 — configurable, country/jurisdiction-driven call-opening disclosures.
  /// Never a hard-coded legal assumption: an organisation with no `countryCode` set gets no
  /// inferred disclosure text, only whatever it explicitly configures here.
  countryCode                    String?
  openingDisclosureText          String?
  recordingDisclosureText        String?
  disclosureRequired             Boolean  @default(true)
  /// Phase 22C item 1 — the wss:// URL of the deployed media-bridge process that terminates the
  /// telephony provider's real-time audio stream (see `MediaStreamSession`). Never set in this
  /// environment (no such process is deployed); `null` means Twilio TwiML generation cannot
  /// request media streaming, which `getVoiceHealthStatus` reports honestly rather than claiming
  /// live audio is available.
  mediaStreamWsUrl               String?
  /// Phase 22C item 12 — cost-protection ceilings, operator-configurable per organisation exactly
  /// like the existing `maxOutboundCallsPerDay`/`retryDelaySeconds`.
  maxCallDurationSeconds         Int      @default(1800)
  maxConsecutiveOutboundFailures Int      @default(3)
  /// Phase 22C item 11 — concurrency readiness, config-driven (never a hard-coded plan name).
  maxConcurrentCallsPerEmployee  Int      @default(3)
  maxConcurrentOutboundCalls     Int      @default(10)
  /// Phase 22C item 10 — what happens to a NEW inbound call once this organisation's monthly
  /// voice-minute entitlement is already exhausted. `HANDOFF` (the safe default) never drops an
  /// emergency/tenant caller silently — it always still connects them to a human-handoff record,
  /// exactly like the existing "no AI employee configured" fallback already does; it only skips AI
  /// handling. `AI_ANYWAY` is an explicit, logged grace opt-in an organisation can choose.
  exhaustedMinutesBehavior       String   @default("HANDOFF")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// A single telephone call (item 12). Deliberately thin: every business-context field (related
/// listing/tenant/lead/property/work order, assigned AI employee, status, rolling summary) lives
/// on the `Conversation` this call belongs to — the same channel-agnostic model WhatsApp/SMS/web
/// chat already use — rather than being duplicated here. This model holds only what is specific
/// to the *telephony* leg of that conversation.
model VoiceCall {
  id                     String                    @id @default(uuid()) @db.Uuid
  organisationId         String                    @db.Uuid
  conversationId         String                    @db.Uuid
  aiEmployeeId           String?                   @db.Uuid
  direction              VoiceCallDirection
  status                 VoiceCallStatus           @default(QUEUED)
  fromNumber             String
  toNumber               String
  providerKey            String
  providerCallId         String
  queuedAt               DateTime                  @default(now())
  ringingAt              DateTime?
  answeredAt             DateTime?
  endedAt                DateTime?
  durationSeconds        Int?
  recordingUrl           String?
  recordingConsentStatus VoiceConsentStatus        @default(NOT_REQUIRED)
  /// Full-call transcript, present only once the call completes and only when permitted (item 12:
  /// "Do not expose private transcripts publicly" — never selected in any public-facing query).
  transcriptText         String?
  aiSummary              String?
  outcome                VoiceCallOutcome          @default(NONE)
  handoffId              String?                   @db.Uuid
  /// Mirrors `ConversationIdentityLevel` (item 5) — a phone number match alone reaches CLAIMED at
  /// most; VERIFIED requires the voice-specific second factor in `verifyVoiceCallerIdentity`.
  callerIdentityLevel    ConversationIdentityLevel @default(NONE)
  initiatedByUserId      String?                   @db.Uuid
  /// Set only for an outbound artisan call (item 7) — links back to the existing
  /// `MaintenanceDispatchAttempt` this call is fulfilling, so dispatch-hierarchy state (item 6/13)
  /// is never duplicated here.
  dispatchAttemptId      String?                   @db.Uuid
  retryOfCallId          String?                   @db.Uuid
  retryCount             Int                       @default(0)
  failureReason          String?
  /// Phase 22B item 14 — real, per-call usage/cost readiness. Accumulated as the call progresses
  /// (never estimated/fabricated up front) — defaults to 0 rather than `null` so `{ increment }`
  /// updates always land on a real numeric starting value (Postgres arithmetic on NULL is NULL).
  sttSecondsUsed         Float                     @default(0)
  ttsCharactersUsed      Int                       @default(0)
  aiModelTokensUsed      Int                       @default(0)
  providerCostAmount     Decimal?                  @db.Decimal(10, 4)
  providerCostCurrency   String?
  /// Phase 22B item 8 — human-transfer readiness, independent of the existing `handoffId`
  /// (an `AIEmployeeHandoff`/`escalateLeadToHuman` queue entry always exists for a transfer;
  /// these fields record whether the *live call itself* was also bridged to a human number).
  transferStatus         VoiceTransferStatus       @default(NONE)
  transferTargetNumber   String?
  transferredAt          DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  organisation        Organisation                @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  conversation        Conversation                @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  aiEmployee          AIEmployee?                 @relation(fields: [aiEmployeeId], references: [id], onDelete: SetNull)
  handoff             AIEmployeeHandoff?          @relation(fields: [handoffId], references: [id], onDelete: SetNull)
  initiatedBy         User?                       @relation("VoiceCallInitiator", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  dispatchAttempt     MaintenanceDispatchAttempt? @relation(fields: [dispatchAttemptId], references: [id], onDelete: SetNull)
  retryOf             VoiceCall?                  @relation("VoiceCallRetry", fields: [retryOfCallId], references: [id], onDelete: SetNull)
  retries             VoiceCall[]                 @relation("VoiceCallRetry")
  events              VoiceCallEvent[]
  turns               VoiceCallTurn[]
  streamingSession    VoiceStreamingSession?
  mediaStreamSessions MediaStreamSession[]

  @@unique([providerKey, providerCallId])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, direction, createdAt])
  @@index([conversationId])
  @@index([dispatchAttemptId])
}

/// Raw provider webhook/event audit trail (item 1/13/20). `[providerKey, externalEventId]` is the
/// idempotency key every webhook receiver checks first — an identical event delivered twice (a
/// provider retry) is a no-op, never a double-processed call state transition.
model VoiceCallEvent {
  id              String   @id @default(uuid()) @db.Uuid
  callId          String   @db.Uuid
  providerKey     String
  externalEventId String
  type            String
  payload         Json
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([providerKey, externalEventId])
  @@index([callId, occurredAt])
}

/// Do-not-call / contact preference registry (item 15), scoped per organisation (a Marketplace
/// professional's backing organisation for marketplace-side opt-outs).
model VoiceContactPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  phoneNumber    String
  doNotCall      Boolean  @default(true)
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, phoneNumber])
}

// ---------------------------------------------------------------------------
// Phase 22B — Real-Time Telephony + Speech AI
// ---------------------------------------------------------------------------

enum VoiceTransferStatus {
  NONE
  REQUESTED
  CONNECTED
  FAILED
}

enum VoiceCallTurnSpeaker {
  CALLER
  AI
  SYSTEM
}

enum VoiceStreamingSessionStatus {
  ACTIVE
  CLOSED
  TIMED_OUT
}

/// The live turn-taking state of an in-progress call (item 3). Distinct from `VoiceCallStatus`
/// (the telephony leg's own lifecycle) — a call can be `IN_PROGRESS` for its entire duration while
/// this state cycles between listening, AI speech, and processing many times.
enum VoiceConversationState {
  LISTENING
  AI_SPEAKING
  PROCESSING
  SILENCE_WARNING
}

enum PhoneNumberPurpose {
  TENANT_SUPPORT
  SALES
  DEVELOPMENT
  GENERAL_OFFICE
}

enum PhoneNumberStatus {
  ACTIVE
  INACTIVE
  RELEASED
}

/// Phone-number assignment readiness (item 9). Deliberately additive to — never a replacement
/// for — `VoiceProviderConfig.phoneNumber` (the original single-number-per-organisation field from
/// Phase 22): `startInboundCall` routing checks this table first (by `[providerKey, e164Number]`)
/// and only falls back to the legacy single-number lookup when no row matches, so an organisation
/// that has never configured a `PhoneNumber` row keeps working exactly as before. Never stores a
/// provider secret — only the number itself and NesAfric-side routing/assignment metadata.
model PhoneNumber {
  id                   String             @id @default(uuid()) @db.Uuid
  organisationId       String             @db.Uuid
  developmentId        String?            @db.Uuid
  e164Number           String
  providerKey          String             @default("MOCK")
  purpose              PhoneNumberPurpose @default(GENERAL_OFFICE)
  label                String?
  inboundEnabled       Boolean            @default(true)
  outboundEnabled      Boolean            @default(false)
  assignedAIEmployeeId String?            @db.Uuid
  status               PhoneNumberStatus  @default(ACTIVE)
  /// Phase 22C item 11 — per-number concurrency readiness.
  maxConcurrentCalls   Int                @default(5)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  development        Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  assignedAIEmployee AIEmployee?  @relation(fields: [assignedAIEmployeeId], references: [id], onDelete: SetNull)

  @@unique([providerKey, e164Number])
  @@index([organisationId, status])
  @@index([developmentId])
}

/// Approved voice-persona configuration for one AI employee (item 10). Purely presentational/
/// operational data (what the AI says at the top of a call, what it's called, what voice it
/// speaks with) — never consulted for RBAC/entitlement/autonomy decisions, so a persona field can
/// never override system safety policy no matter what an organisation configures here.
model VoicePersonaConfig {
  id                       String   @id @default(uuid()) @db.Uuid
  aiEmployeeId             String   @unique @db.Uuid
  employeeDisplayName      String?
  greetingScript           String?
  businessName             String?
  voiceProfileId           String?
  speakingStyle            String?
  language                 String   @default("en")
  supportedLanguages       String[] @default(["en"])
  escalationPhrase         String?
  officeHoursOverrideStart String?
  officeHoursOverrideEnd   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  aiEmployee AIEmployee @relation(fields: [aiEmployeeId], references: [id], onDelete: Cascade)
}

/// One turn of a live conversation (item 3/17). Structured, sequenced turn history — distinct
/// from `VoiceCall.transcriptText` (a flattened human-readable log line) — so barge-in/interruption
/// and turn order are queryable/testable state rather than only present in prose.
model VoiceCallTurn {
  id          String               @id @default(uuid()) @db.Uuid
  callId      String               @db.Uuid
  sequence    Int
  speaker     VoiceCallTurnSpeaker
  text        String
  isFinal     Boolean              @default(true)
  /// True when this turn (always an AI turn) was cut short by caller barge-in (item 3).
  interrupted Boolean              @default(false)
  startedAt   DateTime             @default(now())
  endedAt     DateTime?
  createdAt   DateTime             @default(now())

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, sequence])
}

/// The live streaming/turn-taking session for one in-progress call (item 3/17) — one row per
/// `VoiceCall`, created when the call is answered and closed when it ends. Represents the
/// "streaming-session lifecycle" (item 19's test list) independently of real audio transport: it
/// is driven by transcript deltas (from a real STT stream, or a test's simulated deltas) rather
/// than raw audio frames, so its turn-taking/barge-in/silence-timeout logic is fully testable
/// without a live media connection.
model VoiceStreamingSession {
  id                      String                      @id @default(uuid()) @db.Uuid
  callId                  String                      @unique @db.Uuid
  status                  VoiceStreamingSessionStatus @default(ACTIVE)
  state                   VoiceConversationState      @default(LISTENING)
  pendingTranscriptBuffer String?
  turnSequence            Int                         @default(0)
  silenceTimeoutSeconds   Int                         @default(8)
  lastActivityAt          DateTime                    @default(now())
  startedAt               DateTime                    @default(now())
  endedAt                 DateTime?
  disconnectReason        String?

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 22C — Live Media Bridge + Voice Runtime Enforcement
// ---------------------------------------------------------------------------

enum MediaStreamStatus {
  PENDING
  CONNECTED
  CLOSED
  EXPIRED
  REJECTED
}

/// The authenticated, provider-verified real-time media connection for one call (item 1/2). A
/// `streamToken` is issued server-side the moment a call is answered and handed to the telephony
/// provider (never to the caller/client); whoever presents that exact token is the only party ever
/// trusted to submit audio for the `callId`/`organisationId` this row resolves to — those two ids
/// are NEVER accepted as caller-supplied input anywhere in `media-bridge.ts` (item 2's "never
/// trust organisation/user IDs supplied by the audio client itself"). A partial unique index (see
/// the migration) enforces at most one `PENDING`/`CONNECTED` row per `callId` at the database
/// level, closing the race window a purely application-level check could not (item 10/11).
model MediaStreamSession {
  id               String            @id @default(uuid()) @db.Uuid
  callId           String            @db.Uuid
  organisationId   String            @db.Uuid
  providerKey      String
  streamToken      String            @unique
  tokenExpiresAt   DateTime
  status           MediaStreamStatus @default(PENDING)
  connectedAt      DateTime?
  lastFrameAt      DateTime?
  closedAt         DateTime?
  disconnectReason String?
  frameCount       Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  call         VoiceCall    @relation(fields: [callId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([organisationId, status])
  @@index([status, tokenExpiresAt])
}
