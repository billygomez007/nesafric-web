model AIEmployee {
  id                        String                       @id @default(uuid()) @db.Uuid
  /// Phase 21 item 9 — exactly one of `organisationId`/`marketplaceProfessionalId` is set,
  /// enforced in `ai-employees/service.ts` (a PropertyOS AI employee) and
  /// `marketplace-ai/service.ts` (a Marketplace AI employee) respectively — never both, so a
  /// single employee can never straddle both workspaces (item 24).
  organisationId            String?                      @db.Uuid
  marketplaceProfessionalId String?                      @db.Uuid
  name                      String
  role                      AIEmployeeRole
  description               String?
  status                    AIEmployeeStatus             @default(ACTIVE)
  scope                     AIEmployeeScope              @default(ORGANISATION)
  responsibilities          Json
  instructions              Json
  escalationConfiguration   Json
  workingHours              Json?
  timezone                  String                       @default("UTC")
  providerKey               String?
  modelKey                  String?
  createdByUserId           String                       @db.Uuid
  updatedByUserId           String                       @db.Uuid
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  archivedAt                DateTime?
  organisation              Organisation?                @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  marketplaceProfessional   MarketplaceProfessional?     @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Restrict)
  createdBy                 User                         @relation("AIEmployeeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                 User                         @relation("AIEmployeeUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  portfolios                AIEmployeePortfolio[]
  properties                AIEmployeeProperty[]
  toolPermissions           AIEmployeeToolPermission[]
  autonomyPolicies          AIEmployeeAutonomyPolicy[]
  activities                AIEmployeeActivity[]
  handoffs                  AIEmployeeHandoff[]
  conversations             Conversation[]
  initiatedDispatchAttempts MaintenanceDispatchAttempt[]
  voiceCalls                VoiceCall[]
  assignedPhoneNumbers      PhoneNumber[]
  voicePersonaConfig        VoicePersonaConfig?

  @@unique([organisationId, name])
  @@unique([marketplaceProfessionalId, name])
  @@index([organisationId, status, role])
  @@index([marketplaceProfessionalId, status, role])
}

