  channels       NotificationChannel[]
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, eventType, daysOffset, recipientType])
}

model Notification {
  id                   String              @id @default(uuid()) @db.Uuid
  organisationId       String              @db.Uuid
  leaseId              String?             @db.Uuid
  tenantOrganisationId String?             @db.Uuid
  eventType            ReminderEventType
  thresholdDays        Int?
  /// Disambiguates repeatable per-transaction notifications (e.g. one per payment) from
  /// the lease-threshold reminders this table originally modeled. Reminders always use the
  /// default "" value, which preserves their original de-duplication behaviour exactly;
  /// transaction-driven notifications (e.g. payment received/failed) set it to the source
  /// record id so repeat events for the same lease/tenant/channel are not treated as duplicates.
  dedupeReference      String              @default("")
  channel              NotificationChannel
  status               NotificationStatus  @default(PENDING)
  scheduledAt          DateTime
  processingAt         DateTime?
