  /// Phase 21 item 9/24 — exactly one of these is set, mirroring `AIEmployee`.
  organisationId            String?                  @db.Uuid
  marketplaceProfessionalId String?                  @db.Uuid
  aiEmployeeId              String                   @db.Uuid
  type                      String
  status                    String
  actionKey                 String?
  policyDecision            String?
  reason                    String
  affectedEntities          Json
  result                    Json?
  failureCode               String?
  failureMessage            String?
  idempotencyKey            String
  triggeringUserId          String?                  @db.Uuid
  humanApproverId           String?                  @db.Uuid
  createdAt                 DateTime                 @default(now())
  completedAt               DateTime?
  organisation              Organisation?            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  marketplaceProfessional   MarketplaceProfessional? @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Restrict)
  aiEmployee                AIEmployee               @relation(fields: [aiEmployeeId], references: [id], onDelete: Restrict)

  @@unique([organisationId, idempotencyKey])
  @@unique([marketplaceProfessionalId, idempotencyKey])
  @@index([aiEmployeeId, status, createdAt])
  @@index([organisationId, createdAt])
  @@index([marketplaceProfessionalId, createdAt])
}

model AIEmployeeHandoff {
  id                             String                         @id @default(uuid()) @db.Uuid
  /// Phase 21 item 9/24 — exactly one of these is set, mirroring `AIEmployee`. A Marketplace AI
  /// employee (e.g. AI Sales Agent) escalating to a human uses `marketplaceProfessionalId` and
  /// `assignedRepresentativeMemberId` instead of the PropertyOS `organisationId`/
  /// `assignedMemberId` pair.
  organisationId                 String?                        @db.Uuid
  marketplaceProfessionalId      String?                        @db.Uuid
  aiEmployeeId                   String                         @db.Uuid
  conversationId                 String?
  operationalItemType            String?
  operationalItemId              String?
  reason                         String
  urgency                        AISeverity
  assignedMemberId               String?                        @db.Uuid
  assignedRepresentativeMemberId String?                        @db.Uuid
  assignedTeamReference          String?
  status                         AIHandoffStatus                @default(OPEN)
  contextSummary                 String
  createdByUserId                String?                        @db.Uuid
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  resolvedAt                     DateTime?
  organisation                   Organisation?                  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  marketplaceProfessional        MarketplaceProfessional?       @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: Restrict)
  aiEmployee                     AIEmployee                     @relation(fields: [aiEmployeeId], references: [id], onDelete: Restrict)
  assignedMember                 OrganisationMember?            @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  assignedRepresentativeMember   MarketplaceProfessionalMember? @relation(fields: [assignedRepresentativeMemberId], references: [id], onDelete: SetNull)
  createdBy                      User?                          @relation("AIHandoffCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voiceCalls                     VoiceCall[]

  @@index([organisationId, status, urgency])
  @@index([marketplaceProfessionalId, status, urgency])
  @@index([aiEmployeeId, createdAt])
}

model AIToolExecution {
  id                 String        @id @default(uuid()) @db.Uuid
  organisationId     String        @db.Uuid
  sessionId          String        @db.Uuid
  userId             String        @db.Uuid
  toolKey            String
  actionLevel        AIActionLevel
  requiredPermission String
  arguments          Json
  result             Json?
  status             String
  errorCode          String?
  errorMessage       String?
  recordsAccessed    Json?
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  session            AISession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organisationId, sessionId, startedAt])
  @@index([toolKey, status])
}

model AIActionProposal {
  id                   String           @id @default(uuid()) @db.Uuid
  organisationId       String           @db.Uuid
  sessionId            String           @db.Uuid
  requestedByUserId    String           @db.Uuid
  toolKey              String
  arguments            Json
  explanation          String
  reason               String
  expectedResult       String
  affectedEntities     Json
  actionLevel          AIActionLevel
  status               AIProposalStatus @default(PROPOSED)
  requiredPermission   String
  decidedByUserId      String?          @db.Uuid
  decisionReason       String?
  decidedAt            DateTime?
  expiresAt            DateTime?
  executionResult      Json?
  failureCode          String?
  failureMessage       String?
  executionStartedAt   DateTime?
  executionCompletedAt DateTime?
