model Listing {
  id                          String                        @id @default(uuid()) @db.Uuid
  organisationId              String                        @db.Uuid
  propertyId                  String?                       @db.Uuid
  marketplaceAssetId          String?                       @db.Uuid
  unitId                      String?                       @db.Uuid
  createdByUserId             String                        @db.Uuid
  listingType                 ListingType
  category                    String
  title                       String
  publicDescription           String
  askingAmountMinor           Decimal?                      @db.Decimal(19, 0)
  rentAmountMinor             Decimal?                      @db.Decimal(19, 0)
  currencyCode                String                        @db.Char(3)
  frequency                   RentFrequency?
  availableFrom               DateTime
  bedrooms                    Int?
  bathrooms                   Decimal?                      @db.Decimal(4, 1)
  sizeSqm                     Decimal?                      @db.Decimal(12, 2)
  countryCode                 String                        @db.Char(2)
  region                      String?
  city                        String?
  district                    String?
  locality                    String?
  publicLocationLabel         String?
  mapLatitude                 Decimal?                      @db.Decimal(10, 7)
  mapLongitude                Decimal?                      @db.Decimal(10, 7)
  mapPrecision                ListingLocationPrecision?
  contactName                 String?
  contactEmail                String?
  contactPhone                String?
  showContactEmail            Boolean                       @default(false)
  showContactPhone            Boolean                       @default(false)
  enquiryEnabled              Boolean                       @default(true)
  privateNotes                String?
  status                      ListingStatus                 @default(DRAFT)
  verificationStatus          ListingVerificationStatus     @default(UNVERIFIED)
  evidenceReady               Boolean                       @default(false)
  /// Phase 21A item 5 ("Marketplace Listing Authority") — purely additive attribution, optional
  /// on every existing listing. `organisationId`/`propertyId` above remain the authoritative,
  /// required PropertyOS scoping (unchanged, so every pre-21A isolation guarantee still holds);
  /// these fields separately record *who is marketing* the listing when that differs from "the
  /// organisation that manages the property in PropertyOS" — e.g. a brokerage marketing a
  /// landlord's property, or a developer's sales representative. `listingAuthority` names the
  /// relationship; `marketplaceProfessionalId`/`listingRepresentativeUserId` name the parties.
  listingAuthority            ListingAuthority?
  marketplaceProfessionalId   String?                       @db.Uuid
  listingRepresentativeUserId String?                       @db.Uuid
  /// Present when this listing markets inventory from a developer's `Development`/
  /// `DevelopmentUnit` (Phase 21A item 3) rather than (or in addition to) the PropertyOS
  /// `Property`/`Unit` above.
  developmentId               String?                       @db.Uuid
  developmentUnitId           String?                       @db.Uuid
  submittedAt                 DateTime?
  publishedAt                 DateTime?
  pausedAt                    DateTime?
  reservedAt                  DateTime?
  rentedAt                    DateTime?
  archivedAt                  DateTime?
  rejectedAt                  DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  organisation                Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property                    Property?                     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  marketplaceAsset            MarketplaceAsset?             @relation(fields: [marketplaceAssetId], references: [id], onDelete: Restrict)
  unit                        Unit?                         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy                   User                          @relation("ListingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  marketplaceProfessional     MarketplaceProfessional?      @relation(fields: [marketplaceProfessionalId], references: [id], onDelete: SetNull)
  listingRepresentative       User?                         @relation("ListingRepresentative", fields: [listingRepresentativeUserId], references: [id], onDelete: SetNull)
  development                 Development?                  @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  developmentUnit             DevelopmentUnit?              @relation(fields: [developmentUnitId], references: [id], onDelete: SetNull)
  amenities                   ListingAmenity[]
  media                       ListingMedia[]
  verificationEvidence        ListingVerificationEvidence[]
  statusHistory               ListingStatusHistory[]
  verificationHistory         ListingVerificationHistory[]
  leads                       MarketplaceLead[]
  viewingRequests             ViewingRequest[]
  rentalApplications          RentalApplication[]
  conversations               Conversation[]
  attributionHistory          ListingAttributionHistory[]

  @@index([organisationId, status, createdAt])
  @@index([propertyId, createdAt])
  @@index([marketplaceAssetId, createdAt])
  @@index([unitId, createdAt])
  @@index([status, listingType, countryCode, availableFrom])
  @@index([currencyCode, rentAmountMinor])
  @@index([currencyCode, askingAmountMinor])
  @@index([marketplaceProfessionalId, status])
  @@index([developmentId])
  @@index([developmentUnitId])
}

