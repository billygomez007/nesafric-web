generator client {
  provider = "prisma-client"
  output   = "../src/platform/database/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganisationType {
  INDIVIDUAL_LANDLORD
  PROPERTY_MANAGEMENT
  REAL_ESTATE
  DEVELOPER
  OTHER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  INACTIVE
}

enum OwnerType {
  PERSON
  ORGANISATION
  COMPANY
  FAMILY
  INVESTMENT_ENTITY
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  CANCELLED
}

enum RentFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum LeasePartyRole {
  TENANT
  GUARANTOR
  OCCUPANT
}

enum RenewalStatus {
  NOT_RENEWED
  PENDING
  RENEWED
  NOT_APPLICABLE
}

enum MoveStatus {
  NOT_MOVED_IN
  MOVED_IN
  MOVED_OUT
}

enum RenewalWorkflowStatus {
  NONE
  REQUESTED
  UNDER_DISCUSSION
  APPROVED
  DECLINED
  COMPLETED
}

enum RentObligationStatus {
  UPCOMING
  DUE
  OVERDUE
  CANCELLED
  SATISFIED
}

enum ReminderEventType {
  LEASE_EXPIRY
  RENT_DUE
  RENT_OVERDUE
  DOCUMENT_EXPIRY
  INSPECTION_DUE
  MAINTENANCE_FOLLOWUP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id              String                   @id @default(uuid()) @db.Uuid
  email           String                   @unique @db.Citext
  passwordHash    String
  displayName     String
  emailVerifiedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  sessions        Session[]
  memberships     OrganisationMember[]
  invitations     OrganisationInvitation[] @relation("InvitationSender")
  audits          AuditEvent[]             @relation("AuditActor")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Country {
  code                String         @id @db.Char(2)
  name                String
  defaultCurrencyCode String         @db.Char(3)
  timezone            String
  phonePrefix         String
  isActive            Boolean        @default(true)
  organisations       Organisation[]
}

model Currency {
  code      String  @id @db.Char(3)
  name      String
  minorUnit Int
  symbol    String?
  isActive  Boolean @default(true)
}

model Organisation {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String
  type                OrganisationType
  countryCode         String                   @db.Char(2)
  defaultCurrencyCode String                   @db.Char(3)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  archivedAt          DateTime?
  country             Country                  @relation(fields: [countryCode], references: [code])
  members             OrganisationMember[]
  invitations         OrganisationInvitation[]
  portfolios          Portfolio[]
  properties          Property[]               @relation("ManagingOrganisation")
  auditEvents         AuditEvent[]
  domainEvents        DomainEvent[]
  tenants             TenantOrganisation[]
  leases              Lease[]
  reminderPolicies    ReminderPolicy[]
  notifications       Notification[]
  backgroundJobs      BackgroundJob[]
  notifyEmail         Boolean                  @default(true)
  notifySms           Boolean                  @default(false)
  notifyWhatsapp      Boolean                  @default(false)
  rentObligations     RentObligation[]

  @@index([countryCode])
  @@index([archivedAt])
}

model OrganisationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MemberStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now())
  archivedAt     DateTime?
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, status])
}

model Role {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique
  name        String
  description String?
  isSystem    Boolean                  @default(true)
  permissions RolePermission[]
  memberRoles MembershipRole[]
  invitations OrganisationInvitation[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  memberId String             @db.Uuid
  roleId   String             @db.Uuid
  member   OrganisationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([memberId, roleId])
}

model OrganisationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  email          String           @db.Citext
  roleId         String           @db.Uuid
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organisationId, status])
  @@index([email, status])
}

model Portfolio {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  properties     Property[]

  @@unique([organisationId, name])
  @@index([organisationId, archivedAt])
}

model PropertyOwner {
  id          String     @id @default(uuid()) @db.Uuid
  type        OwnerType
  displayName String
  createdAt   DateTime   @default(now())
  properties  Property[]
}

model Property {
  id                   String           @id @default(uuid()) @db.Uuid
  organisationId       String           @db.Uuid
  portfolioId          String?          @db.Uuid
  ownerId              String?          @db.Uuid
  referenceNumber      String
  name                 String
  description          String?
  category             String
  countryCode          String           @db.Char(2)
  region               String?
  city                 String?
  district             String?
  addressLine1         String?
  digitalAddress       String?
  latitude             Decimal?         @db.Decimal(10, 7)
  longitude            Decimal?         @db.Decimal(10, 7)
  currencyCode         String           @db.Char(3)
  status               PropertyStatus   @default(ACTIVE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  archivedAt           DateTime?
  managingOrganisation Organisation     @relation("ManagingOrganisation", fields: [organisationId], references: [id], onDelete: Restrict)
  portfolio            Portfolio?       @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  owner                PropertyOwner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  buildings            Building[]
  units                Unit[]
  leases               Lease[]
  rentObligations      RentObligation[]

  @@unique([organisationId, referenceNumber])
  @@index([organisationId, archivedAt, status])
  @@index([portfolioId])
}

model Building {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  units      Unit[]
  leases     Lease[]

  @@unique([propertyId, name])
  @@index([propertyId, archivedAt])
}

model Unit {
  id              String           @id @default(uuid()) @db.Uuid
  propertyId      String           @db.Uuid
  buildingId      String?          @db.Uuid
  name            String
  unitType        String?
  floor           String?
  bedrooms        Int?
  bathrooms       Int?
  sizeSqm         Decimal?         @db.Decimal(12, 2)
  status          UnitStatus       @default(AVAILABLE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  building        Building?        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  leases          Lease[]
  rentObligations RentObligation[]

  @@unique([propertyId, buildingId, name])
  @@index([propertyId, archivedAt, status])
  @@index([buildingId])
}

model Tenant {
  id            String               @id @default(uuid()) @db.Uuid
  legalName     String
  preferredName String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  organisations TenantOrganisation[]
}

model TenantOrganisation {
  id                           String         @id @default(uuid()) @db.Uuid
  tenantId                     String         @db.Uuid
  organisationId               String         @db.Uuid
  email                        String?        @db.Citext
  phone                        String?
  addressLine1                 String?
  city                         String?
  countryCode                  String?        @db.Char(2)
  notes                        String?
  communicationEmailAllowed    Boolean        @default(true)
  communicationSmsAllowed      Boolean        @default(false)
  communicationWhatsappAllowed Boolean        @default(false)
  communicationInAppAllowed    Boolean        @default(true)
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  archivedAt                   DateTime?
  tenant                       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organisation                 Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  leaseParties                 LeaseParty[]
  notifications                Notification[]

  @@unique([tenantId, organisationId])
  @@index([organisationId, archivedAt])
  @@index([email])
}

model Lease {
  id                    String                @id @default(uuid()) @db.Uuid
  organisationId        String                @db.Uuid
  propertyId            String                @db.Uuid
  unitId                String?               @db.Uuid
  renewedFromLeaseId    String?               @db.Uuid
  referenceNumber       String
  startDate             DateTime              @db.Date
  endDate               DateTime?             @db.Date
  rentAmountMinor       Decimal               @db.Decimal(19, 0)
  currencyCode          String                @db.Char(3)
  rentFrequency         RentFrequency
  customFrequency       String?
  depositAmountMinor    Decimal?              @db.Decimal(19, 0)
  status                LeaseStatus           @default(DRAFT)
  renewalStatus         RenewalStatus         @default(NOT_RENEWED)
  moveStatus            MoveStatus            @default(NOT_MOVED_IN)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  archivedAt            DateTime?
  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property              Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit                  Unit?                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renewedFromLease      Lease?                @relation("LeaseRenewals", fields: [renewedFromLeaseId], references: [id], onDelete: Restrict)
  renewals              Lease[]               @relation("LeaseRenewals")
  parties               LeaseParty[]
  documents             LeaseDocument[]
  history               LeaseHistory[]
  amendments            LeaseAmendment[]
  obligations           RentObligation[]
  notifications         Notification[]
  renewalWorkflowStatus RenewalWorkflowStatus @default(NONE)
  building              Building?             @relation(fields: [buildingId], references: [id])
  buildingId            String?               @db.Uuid

  @@unique([organisationId, referenceNumber])
  @@index([organisationId, status, endDate])
  @@index([propertyId, unitId])
  @@index([renewedFromLeaseId])
}

model LeaseAmendment {
  id              String   @id @default(uuid()) @db.Uuid
  leaseId         String   @db.Uuid
  sequence        Int
  summary         String
  changes         Json
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  lease           Lease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([leaseId, sequence])
}

model RentObligation {
  id             String               @id @default(uuid()) @db.Uuid
  organisationId String               @db.Uuid
  leaseId        String               @db.Uuid
  propertyId     String               @db.Uuid
  unitId         String?              @db.Uuid
  dueDate        DateTime             @db.Date
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  amountMinor    Decimal              @db.Decimal(19, 0)
  currencyCode   String               @db.Char(3)
  status         RentObligationStatus @default(UPCOMING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lease          Lease                @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  property       Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit           Unit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([leaseId, periodStart, periodEnd])
  @@index([organisationId, status, dueDate])
}

model ReminderPolicy {
  id             String                @id @default(uuid()) @db.Uuid
  organisationId String                @db.Uuid
  eventType      ReminderEventType
  daysOffset     Int
  recipientType  String
  channels       NotificationChannel[]
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, eventType, daysOffset, recipientType])
}

model Notification {
  id                   String              @id @default(uuid()) @db.Uuid
  organisationId       String              @db.Uuid
  leaseId              String?             @db.Uuid
  tenantOrganisationId String?             @db.Uuid
  eventType            ReminderEventType
  thresholdDays        Int?
  channel              NotificationChannel
  status               NotificationStatus  @default(SCHEDULED)
  scheduledAt          DateTime
  sentAt               DateTime?
  providerReference    String?
  retryCount           Int                 @default(0)
  createdAt            DateTime            @default(now())
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenantOrganisation   TenantOrganisation? @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)

  @@unique([leaseId, tenantOrganisationId, eventType, thresholdDays, channel])
  @@index([organisationId, status, scheduledAt])
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String?             @db.Uuid
  type           String
  idempotencyKey String              @unique
  payload        Json
  status         BackgroundJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  runAt          DateTime            @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organisation   Organisation?       @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([organisationId, status])
}

model LeaseParty {
  id                   String             @id @default(uuid()) @db.Uuid
  leaseId              String             @db.Uuid
  tenantOrganisationId String             @db.Uuid
  role                 LeasePartyRole     @default(TENANT)
  isPrimary            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  lease                Lease              @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenantOrganisation   TenantOrganisation @relation(fields: [tenantOrganisationId], references: [id], onDelete: Restrict)

  @@unique([leaseId, tenantOrganisationId, role])
  @@index([tenantOrganisationId])
}

model LeaseDocument {
  id          String   @id @default(uuid()) @db.Uuid
  leaseId     String   @db.Uuid
  fileKey     String
  fileName    String
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([leaseId, fileKey])
}

model LeaseHistory {
  id                 String        @id @default(uuid()) @db.Uuid
  leaseId            String        @db.Uuid
  version            Int
  status             LeaseStatus
  startDate          DateTime      @db.Date
  endDate            DateTime?     @db.Date
  rentAmountMinor    Decimal       @db.Decimal(19, 0)
  currencyCode       String        @db.Char(3)
  rentFrequency      RentFrequency
  depositAmountMinor Decimal?      @db.Decimal(19, 0)
  notes              String?
  changedByUserId    String?       @db.Uuid
  createdAt          DateTime      @default(now())
  lease              Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([leaseId, version])
  @@index([leaseId, createdAt])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  requestId      String?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model DomainEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  name           String
  aggregateType  String
  aggregateId    String
  payload        Json
  occurredAt     DateTime     @default(now())
  processedAt    DateTime?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, occurredAt])
  @@index([processedAt, occurredAt])
}
