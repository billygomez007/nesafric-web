DATABASE_URL="postgresql://propertyos:propertyos@localhost:5432/propertyos?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Public base URL of this deployment (no trailing slash). Used to build provider callback/webhook
# URLs (e.g. Twilio status callbacks). Required for real telephony; harmless to leave unset otherwise.
APP_BASE_URL=""
# Canonical public site URL (no trailing slash) — drives `metadataBase`, OpenGraph/Twitter URLs,
# JSON-LD, and every absolute link/logo URL built into transactional emails (see
# `src/platform/brand.ts`). Defaults to "https://umoafric.com" (the intended production domain)
# when unset. Staging/preview deployments MUST set this to their own URL, otherwise their pages
# and emails will claim to be umoafric.com while not actually being served from it.
NEXT_PUBLIC_SITE_URL=""

# GA4 Measurement ID (e.g. "G-XXXXXXXXXX") for the production umoafric.com property — see
# `src/platform/analytics.ts`. Deliberately has NO fallback in code: leave this unset in every
# environment except real Production, otherwise dev/Preview traffic pollutes production analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional platform-wide AI-autonomy kill switch (independent of the per-organisation pause
# control in Settings). Set to "true" to immediately stop all AI auto-execute actions across every
# organisation — requires a redeploy/restart to take effect on most hosting platforms, so it is a
# secondary/incident-response lever, not a runtime toggle.
AI_AUTOMATION_PLATFORM_PAUSED=""

# Shared secrets for /api/jobs/run, which drains the BackgroundJob queue (reminders, notification
# delivery, AI proactive evaluation, conversation delivery, calendar sync) and sweeps expired
# guest-write records. Production MUST call this endpoint on an interval via a scheduler, OR run
# `npm run worker` as a standalone process instead — otherwise the job queue never drains.
# The endpoint FAILS CLOSED: with neither CRON_SECRET nor JOBS_RUN_SECRET set, every call gets 503.
# - CRON_SECRET: set this for Vercel Cron (vercel.json); Vercel sends `Authorization: Bearer $CRON_SECRET`.
# - JOBS_RUN_SECRET: for other schedulers (header `x-jobs-run-secret` or `Authorization: Bearer`).
JOBS_RUN_SECRET=""
CRON_SECRET=""
# Local development only: "true" lets /api/jobs/run run without a secret. Ignored when NODE_ENV=production.
ALLOW_UNAUTHENTICATED_JOBS_RUN=""
# Poll interval for `npm run worker`, in milliseconds. Defaults to 15000 (15s) when unset.
WORKER_POLL_INTERVAL_MS=""

# Optional. PropertyOS uses its deterministic AI mode when these are unset.
AI_PROVIDER="openai-compatible"
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-4o-mini"
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER_TIMEOUT_MS="30000"
AI_PROVIDER_MAX_RETRIES="2"
AI_PROVIDER_RETRY_DELAY_MS="250"
# Optional estimated provider cost per million tokens, expressed in nano-units.
AI_PROVIDER_INPUT_COST_PER_MILLION_NANO_UNITS=""
AI_PROVIDER_OUTPUT_COST_PER_MILLION_NANO_UNITS=""

# Optional. Ghana payment collection gateways (MTN Mobile Money, Telecel Cash, AT Money) plus
# card/bank readiness. Each is independently provider-neutral: point BASE_URL/API_KEY at the
# vendor's direct API or an aggregator that unifies them, matching the SMS/WhatsApp channel
# pattern elsewhere in this file. Leave a provider's variables unset to keep it registered but
# reported as unavailable; checkout initiation for that provider fails clearly rather than
# fabricating a successful transaction. Webhook secrets must be set for that provider's webhook
# to be accepted at all — an unverifiable payment webhook is never trusted.
MTN_MOMO_BASE_URL=""
MTN_MOMO_API_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_WEBHOOK_SECRET=""

TELECEL_CASH_BASE_URL=""
TELECEL_CASH_API_KEY=""
TELECEL_CASH_MERCHANT_ID=""
TELECEL_CASH_WEBHOOK_SECRET=""

AT_MONEY_BASE_URL=""
AT_MONEY_API_KEY=""
AT_MONEY_MERCHANT_ID=""
AT_MONEY_WEBHOOK_SECRET=""

# Card and bank-transfer readiness (not Ghana mobile-money specific; any hosted-checkout or
# virtual-account processor speaking the same collection contract can be configured here).
CARD_PAYMENTS_BASE_URL=""
CARD_PAYMENTS_API_KEY=""
CARD_PAYMENTS_WEBHOOK_SECRET=""

BANK_TRANSFER_PAYMENTS_BASE_URL=""
BANK_TRANSFER_PAYMENTS_API_KEY=""
BANK_TRANSFER_PAYMENTS_WEBHOOK_SECRET=""

# Phase 19: provider-neutral object storage. Leave STORAGE_S3_* unset to use the filesystem
# adapter (local dev, durable across requests) automatically; automated tests instead default to
# the in-memory adapter via STORAGE_PROVIDER=memory (set in tests/setup.ts). Any S3-compatible
# provider works here: AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2, Backblaze B2, etc.
# STORAGE_PROVIDER can force a specific adapter ("s3" | "local" | "memory"); otherwise the
# presence of S3 credentials decides automatically.
STORAGE_PROVIDER=""
# Legacy local-development convenience only.
# Vercel Preview/Production must use the explicit PRIVATE/PUBLIC buckets below.
STORAGE_S3_BUCKET=""
STORAGE_S3_PRIVATE_BUCKET=""
STORAGE_S3_PUBLIC_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE=""
# Optional CDN/base URL prefixed onto PUBLIC object keys instead of a bucket-derived URL.
STORAGE_PUBLIC_BASE_URL=""
# Optional override for the local filesystem adapter's signed-URL HMAC secret; falls back to
# SESSION_SECRET when unset. Only relevant when no S3-compatible provider is configured.
STORAGE_LOCAL_SIGNING_SECRET=""
# Optional per-upload byte ceiling (default 25MB).
STORAGE_MAX_UPLOAD_BYTES=""

# Optional malware scan hook (a REST endpoint in front of ClamAV, a commercial scanner, etc — see
# `POST {baseUrl}/scan`). Uploads are stored unscanned (SKIPPED, clearly recorded) when unset.
MALWARE_SCAN_BASE_URL=""
MALWARE_SCAN_API_KEY=""
MALWARE_SCAN_TIMEOUT_MS=""

# Optional provider-neutral e-signature adapter for the Phase 11 lease signature workflow. Leave
# unset to use the deterministic internal adapter (non-legal — signing happens through
# PropertyOS's own internal "sign" action, not a certified e-signature vendor).
ESIGNATURE_BASE_URL=""
ESIGNATURE_API_KEY=""
ESIGNATURE_WEBHOOK_SECRET=""
ESIGNATURE_TIMEOUT_MS=""

# Optional provider-neutral geocoding adapter. Leave unset to use the deterministic, credential-free
# fallback (recognises a small set of known Ghanaian region/city names only; never fabricates
# street-level precision). Any geocoding vendor/aggregator can sit behind GEOCODING_BASE_URL.
GEOCODING_BASE_URL=""
GEOCODING_API_KEY=""
GEOCODING_TIMEOUT_MS=""

# Optional provider-neutral external calendar sync (Google Calendar, Microsoft Graph, or a proxy
# unifying either). Leave unset to keep calendar events internal-only — core scheduling is never
# blocked by this either way.
CALENDAR_BASE_URL=""
CALENDAR_API_KEY=""
CALENDAR_TIMEOUT_MS=""

# Phase 20: provider-neutral SaaS billing (Umo Afric's own subscription billing for organisations —
# completely separate from the Ghana rent-collection gateways above). The deterministic `test`
# adapter is always available and requires nothing here; the app works fully absent any of these.
# Set BILLING_HTTP_BASE_URL/BILLING_HTTP_API_KEY to bill through a real external provider instead.
BILLING_HTTP_BASE_URL=""
BILLING_HTTP_API_KEY=""
BILLING_HTTP_WEBHOOK_SECRET=""
BILLING_HTTP_TIMEOUT_MS=""
# Optional override for the deterministic test billing adapter's webhook HMAC key. This is not a
# real credential — it exists purely so the test adapter's webhook signature verification is
# genuinely exercisable without any external provider configured. Falls back to a fixed,
# publicly-documented constant when unset.
BILLING_TEST_WEBHOOK_SECRET=""

# Optional provider-neutral communication channels (tenant/lead conversations, and — once
# configured — email/SMS/WhatsApp reminder delivery). Leave unset to keep every channel in
# deterministic mock-transport mode (`{status:"SENT", providerReference:"test-<channel>:..."}`) so
# reminders/conversations still work end-to-end in dev/test without any real credentials.
#
# Email is sent via Resend (see src/modules/conversations/channels/email-providers.ts). When
# RESEND_API_KEY is unset, email stays in the deterministic TestEmailProvider mode
# (providerReference prefixed "test-email:") — no external request is ever made. `from`/`replyTo`
# are already resolved to the correct @umoafric.com sender identity in code (see
# `src/platform/brand.ts`); the umoafric.com sending domain must be verified in the Resend
# dashboard (SPF/DKIM/DMARC records) before RESEND_API_KEY is set in any environment.
RESEND_API_KEY=""
# Signing secret for the Resend delivery-events webhook (email.sent/delivered/bounced/...) —
# obtained from the Resend dashboard when the webhook endpoint is registered. Unset means the
# webhook route verifies nothing and rejects all events rather than trusting them.
RESEND_WEBHOOK_SECRET=""
SMS_PROVIDER_SEND_URL=""
SMS_PROVIDER_API_KEY=""
# Arkesel (https://sms.arkesel.com) — SMS and SMS one-time codes. Server-only: never NEXT_PUBLIC_/EXPO_PUBLIC_.
# Without both values phone sign-in codes are refused (503). The sender ID must already be
# approved in the Arkesel account (3-11 characters). See docs/arkesel-sms-otp.md.
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID=""
# Optional: OTP expiry in minutes (1-10, default 5) and length (only 6 is supported).
ARKESEL_OTP_EXPIRY_MINUTES=""
ARKESEL_OTP_LENGTH=""
# HMAC key for code and destination digests (>= 32 chars). Falls back to SESSION_SECRET when unset.
OTP_HASH_SECRET=""
# Cost ceiling: total SMS codes per hour across the platform (default 1000).
OTP_SMS_GLOBAL_HOURLY_LIMIT=""
# WhatsApp Cloud API (Meta). Sends fail closed when these are missing; nothing is simulated.
# Long-lived system-user token with whatsapp_business_messaging permission.
WHATSAPP_PROVIDER_ACCESS_TOKEN=""
# Graph API version used to build https://graph.facebook.com/<version>/<phone-number-id>/messages.
WHATSAPP_GRAPH_API_VERSION="v21.0"
# Optional override of the send URL (a BSP or a test double). Must be HTTPS.
WHATSAPP_PROVIDER_SEND_URL=""
# Meta app secret: every webhook POST is checked against X-Hub-Signature-256 with it.
WHATSAPP_APP_SECRET=""
# Organisation whose WHATSAPP channel config (phoneNumberId, verify token) is the official NesAfric
# number, served at /api/webhooks/whatsapp. Its statuses and notifications cover all organisations.
WHATSAPP_OFFICIAL_ORGANISATION_ID=""
# Approved Meta template for business-initiated notifications, as name:language, with one body
# variable ({{1}}) for the notification text. Unset means WhatsApp notifications are not sent.
WHATSAPP_TEMPLATE_NOTIFICATION=""
# Approved template inviting a maintenance professional into a landlord's network: {{1}} the
# organisation name, {{2}} the work; quick-reply buttons "Accept" and "Decline". Unset means
# invitations are saved but not sent.
WHATSAPP_TEMPLATE_PROVIDER_INVITE=""
# Approved work-order template: {{1}} organisation, {{2}} ticket reference, {{3}} location, {{4}} issue,
# {{5}} urgency, {{6}} what is authorised, {{7}} reply deadline; quick replies "Accept" / "Decline".
# Unset means automatic dispatch escalates to the landlord instead of contacting providers.
WHATSAPP_TEMPLATE_WORK_ORDER=""
# Utility templates U01-U30 (src/modules/whatsapp-templates/registry.ts). Their Meta status is
# synced into the database; nothing here lists them individually.
# The official number's WhatsApp Business Account ID, typed again as a second check: template
# sync and submission refuse to run unless it equals the WABA on the official number's
# platform assignment (keeps other WABAs reachable with the same token, e.g. Tap & Order, untouched).
WHATSAPP_TEMPLATE_WABA_ID=""
# "true" allows `npm run whatsapp:templates -- submit`. Leave unset except while submitting.
WHATSAPP_TEMPLATE_SUBMISSION_ENABLED=""
# ISO time from which business events may send Utility templates (for example
# 2026-11-01T00:00:00Z). Unset means none are sent. Earlier events are never sent.
WHATSAPP_UTILITY_EVENTS_SINCE=""
# Reply to WhatsApp messages right after the webhook answers Meta (Next.js after()), instead of
# waiting for the next /api/jobs/run cron tick. Set to "false" to rely on the cron or worker only.
WHATSAPP_INLINE_PROCESSING=""
# Local testing only (scripts/setup-local-whatsapp.ts): Meta's test number, its WhatsApp Business
# Account and the verify token typed into Meta's webhook settings.
WHATSAPP_LOCAL_PHONE_NUMBER_ID=""
WHATSAPP_LOCAL_BUSINESS_ACCOUNT_ID=""
WHATSAPP_LOCAL_VERIFY_TOKEN=""

# Optional voice/telephony (Phase 22/22B/22C). Live calling is intentionally deferred: the media
# bridge, STT/TTS adapters, and runtime enforcement are all real and already tested against the
# deterministic MOCK provider below with no credentials required. Going live additionally requires
# all of TWILIO_*, STT_PROVIDER_API_KEY, TTS_PROVIDER_API_KEY, and a deployed standalone
# WebSocket media-bridge process (see docs/architecture) — none of which exist by default.
VOICE_PROVIDER_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_BASE_URL=""
# Only used by the MOCK telephony provider's own webhook signing, so local/test webhooks are
# verifiable without any real credentials.
VOICE_MOCK_WEBHOOK_SECRET=""
STT_PROVIDER_API_KEY=""
TTS_PROVIDER_API_KEY=""
TTS_DEFAULT_VOICE_ID=""
# Optional shared secret guarding POST /api/voice/media-stream/sweep (the global orphaned-stream
# cleanup endpoint) — same "enforced only when set" pattern as JOBS_RUN_SECRET above.
VOICE_MEDIA_SWEEP_SECRET=""
# Required shared secret for the provider-facing voice call API (POST /api/voice/inbound and
# /api/voice/calls/**). Sent by the telephony bridge as the `x-voice-provider-secret` header.
# Unset = those endpoints return 503 (fail closed); they expose call state and verified-tenant data.
VOICE_PROVIDER_API_SECRET=""

# Phase 20: explicit Umo Afric platform-administration bootstrap. Comma-separated emails of
# existing PropertyOS user accounts to promote to a SUPER_ADMIN `PlatformPrincipal` — completely
# independent of any `OrganisationMember`/organisation role. Leave unset to disable automatic
# bootstrap entirely; use `npm run platform-admin:bootstrap -- <email> <role>` for manual,
# one-off promotion instead. No HTTP endpoint in this application can create or promote a
# platform principal.
PLATFORM_ADMIN_BOOTSTRAP_EMAILS=""

# Native Google Cloud Storage
#
# NesAfric uses two physically separate GCS buckets:
# - PRIVATE: identity documents and other sensitive files.
# - PUBLIC: listing/provider/marketing media.
#
# Local development can use Google Application Default Credentials:
#   gcloud auth application-default login
#
# Hosted deployments may use GOOGLE_SERVICE_ACCOUNT_JSON or another
# Google ADC-compatible workload identity.
#
# Keep STORAGE_PUBLIC_BASE_URL empty while Google Cloud Public Access
# Prevention is enabled. NesAfric will use its internal media route.
STORAGE_GCS_PROJECT_ID=""
STORAGE_GCS_PRIVATE_BUCKET=""
STORAGE_GCS_PUBLIC_BUCKET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# 32-byte AES key for encrypting team-invitation delivery tokens stored in background jobs.
# Generate for each production environment with: openssl rand -hex 32
INVITATION_TOKEN_ENCRYPTION_KEY=

NEXT_PUBLIC_GTM_ID=""

# --- Guest write abuse protection (enquiries, viewing requests, web chat leads) ---------------
# Client IP identity: on Vercel (VERCEL=1, set automatically) the Vercel-overwritten x-real-ip is
# used. Elsewhere, name ONE header your own proxy overwrites (never a header clients can set):
TRUSTED_CLIENT_IP_HEADER=""
# Keep OFF until the evidence listed in docs/guest-write-protection.md confirms Cloudflare proxies
# the production domain. When "true", cf-connecting-ip is honoured only if the connecting peer is
# inside Cloudflare's ranges.
TRUST_CLOUDFLARE_CLIENT_IP=""
# Optional override of Cloudflare's published ranges (comma-separated CIDRs; see cloudflare.com/ips).
CLOUDFLARE_IP_RANGES=""
# Optional JSON overrides for limits, e.g. {"enquiry.ip.10m":40,"enquiry.contact.hour":5}.
# Keys must be known rule ids (src/platform/security/public-write-limit.ts, DEFAULT_PUBLIC_WRITE_RULES)
# and values integers from 1 to 10000; anything else is ignored with a warning and the default kept.
# Environment variables are read at deploy time on Vercel: redeploy after changing (no code change).
PUBLIC_WRITE_LIMITS=""
